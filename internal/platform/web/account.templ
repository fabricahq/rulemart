// The pages and header parts of accounts: the header's account menu or sign-in link, the sign-in page, and the
// account page.

package web

// accountControl ends the header: the signed-in visitor's cart and avatar, which opens their menu, or a button to
// sign in, or nothing when sign-in isn't available. Its content sits at the page's edge.
templ accountControl(v visitor) {
	if v.account != nil || v.signIn != "" {
		<div class="account-slot flex shrink-0 items-center gap-1">
			if v.account != nil {
				if v.cart {
					@cartLink(v)
				}
				@accountMenu(v)
			} else {
				@signInLink(v)
			}
		</div>
	}
}

// signInButtonStyle is the header's Sign in button: the prototype's small button.
const signInButtonStyle = "inline-flex min-h-8 items-center justify-center gap-2 rounded-full border border-border-strong px-[13px] py-1 text-[13px] font-medium whitespace-nowrap text-ink no-underline transition-colors duration-[160ms] hover:border-ink hover:bg-surface"

// signInLink is the header's way to sign in: a button showing GitHub's mark when signing in is with GitHub, which
// says so beside a phone's width. On the sign-in page it's there too, marked as the current page, so the header
// doesn't change.
templ signInLink(v visitor) {
	<a
		class={ signInButtonStyle }
		href={ templ.SafeURL(v.signIn) }
		if v.onSignInPage {
			aria-current="page"
		}
	>
		@signInLabel(v)
	</a>
}

templ signInLabel(v visitor) {
	if v.withGitHub {
		@githubMark("size-[15px] flex-none")
		<span>Sign in<span class="max-narrow:hidden"> with GitHub</span></span>
	} else {
		<span>Sign in</span>
	}
}

// accountMenu is the signed-in visitor's avatar, a button that opens the prototype's menu naming them, with links to
// their account page, adding a library, their Starred rules, their cart, their listings, and to sign out. The links
// are named for the pages they lead to today; slice R7 restores the prototype's Dashboard when the account page
// becomes it. Sign-out is a form, since it changes state. The button is as wide as the avatar and as tall as a tap,
// so the avatar, the button, and the menu's right edge all sit at the page's edge. Hovered or open, the avatar's
// border darkens, and its focus ring is drawn just inside its circle, so nothing reaches past the edge. menus.js
// closes the menu when focus or a click leaves it.
templ accountMenu(v visitor) {
	<details class="group relative shrink-0" data-menu>
		<summary class="relative flex h-11 w-[30px] cursor-pointer list-none items-center focus-visible:outline-none group-open:[&>span:first-child]:border-border-strong [&:hover>span:first-child]:border-border-strong [&:focus-visible>span:first-child]:outline-2 [&:focus-visible>span:first-child]:-outline-offset-2 [&:focus-visible>span:first-child]:outline-(--focus) [&::-webkit-details-marker]:hidden" aria-label={ accountMenuName(v) } title={ "Signed in as " + v.account.Login }>
			@avatar(v.account.AvatarURL, v.account.Login, avatarRound)
		</summary>
		<div class="absolute top-[47px] right-0 z-40 grid w-[230px] rounded-card border border-border bg-paper p-1.5 shadow-[0_16px_40px_-16px_rgb(0_0_0/.35)]">
			<div class="mb-1 border-b border-border-subtle px-2.5 py-2 text-[13px]">
				<p class="text-faint">Signed in as</p>
				<p class="truncate font-semibold text-ink">{ v.account.Login }</p>
			</div>
			@menuLink(accountHref, "Account", v.onAccountPage)
			if v.listings {
				@menuLink(listHref, "Add a library", v.onListPage)
			}
			if v.stars {
				@menuLink(starredHref, "Starred rules", v.onStarredPage)
			}
			if v.cart {
				<a
					class={ menuItemStyle, "justify-between gap-3 no-underline", templ.KV("font-medium", v.onCartPage) }
					href={ templ.SafeURL(cartHref) }
					if v.onCartPage {
						aria-current="page"
					}
				>
					Your cart
					if v.cartItems > 0 {
						<span class="text-[12.5px] text-faint tabular-nums">{ plural(v.cartItems, "item", "items") }</span>
					}
				</a>
			}
			if v.listings {
				@menuLink(listingsHref, "Your listings", v.onListingsPage)
			}
			<form method="post" action={ templ.SafeURL(v.signOut) }>
				<button class={ menuItemStyle, "w-full cursor-pointer text-left" } type="submit">Sign out</button>
			</form>
		</div>
	</details>
}

// menuLink is one link of the account menu, marked current on its own page.
templ menuLink(href, name string, current bool) {
	<a
		class={ menuItemStyle, "no-underline", templ.KV("font-medium", current) }
		href={ templ.SafeURL(href) }
		if current {
			aria-current="page"
		}
	>{ name }</a>
}

// menuItemStyle is a link or button in a menu, as the prototype's: tall enough to tap. Its focus ring is drawn inside
// it, clear of the menu's border and of the line under the menu's heading.
const menuItemStyle = "flex min-h-10 w-full items-center rounded-lg px-2.5 text-left text-[13.5px] text-ink transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:-outline-offset-2"

// primaryButtonStyle is a page's main action, filled in the primary color.
const primaryButtonStyle = "inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2.5 rounded-full bg-primary px-5 text-[15px] font-medium text-on-primary transition-opacity hover:opacity-85"

// outlineButtonStyle is a secondary action, outlined.
const outlineButtonStyle = "inline-flex min-h-10 cursor-pointer items-center justify-center rounded-full border border-border-strong px-4 text-[14px] font-medium whitespace-nowrap text-ink transition-colors duration-[160ms] hover:border-ink hover:bg-surface"

// dangerButtonStyle is an action that can't be undone, outlined in the color of deletion.
const dangerButtonStyle = "inline-flex min-h-10 cursor-pointer items-center justify-center rounded-full border border-del-ink px-4 text-[14px] font-medium whitespace-nowrap text-del-ink transition-colors duration-[160ms] hover:bg-surface"

// signInPage offers each way to sign in: GitHub, and in a local build, test users. It says what Rulemart reads of a
// GitHub account, and why the last attempt failed, if it did. Search engines have no use for it.
templ signInPage(c chrome, view signInView) {
	@layout(c, head{title: "Sign in · Rulemart", noindex: true}) {
		<div class="page wrap max-w-[30rem] pt-16 max-narrow:pt-10">
			<div class="mx-auto size-11 text-ink">
				@fabricaMark("size-11")
			</div>
			<h1 class="title-xl mt-[18px] mb-6 text-center">Sign in to Rulemart</h1>
			if view.notice != "" {
				<p class="mb-6 rounded-card border border-border-strong px-4 py-3 text-[14px] text-ink" role="alert">{ view.notice }</p>
			}
			if !view.available {
				<p class="text-center text-muted">Sign-in isn't available yet. Browsing needs no account.</p>
			} else {
				<p class="text-center text-muted">Browsing Rulemart needs no account. Signing in lets Rulemart know who you are, with your GitHub account.</p>
				if view.gitHub != "" {
					<form class="mt-7" method="post" action={ templ.SafeURL(view.gitHub) }>
						<button class={ primaryButtonStyle } type="submit">
							@githubMark("size-[18px]")
							Continue with GitHub
						</button>
					</form>
					<p class="mt-4 text-center text-[13px] text-faint">Rulemart asks GitHub only for your public profile, and keeps your GitHub user ID, username, and avatar. It can't see your private repositories or act on GitHub for you.</p>
				}
				if len(view.testUsers) > 0 {
					<section class="mt-9 rounded-card border border-dashed border-border-strong px-5 py-4" aria-labelledby="test-users">
						@labelHeading("") {
							<span id="test-users">Local build</span>
						}
						<p class="mt-1.5 text-[13.5px] text-muted">Sign in as a test user, without GitHub. Release builds don't include this.</p>
						<ul class="mt-3 grid gap-2">
							for _, user := range view.testUsers {
								<li>
									<form method="post" action={ templ.SafeURL(user.action) }>
										<button class={ outlineButtonStyle + " w-full" } type="submit">Sign in as { user.login }</button>
									</form>
								</li>
							}
						</ul>
					</section>
				}
				<p class="mt-6 text-center text-[13px]"><a class="text-muted" href={ templ.SafeURL(privacyHref) }>How Rulemart treats your data</a></p>
			}
		</div>
	}
}

// accountPage shows the signed-in visitor what Rulemart keeps about them, and lets them sign out, everywhere at once,
// or delete their account. Deleting asks first, by opening a disclosure, so it takes two deliberate clicks.
templ accountPage(c chrome, account accountView) {
	@layout(c, head{title: "Account · Rulemart", noindex: true, narrow: true}) {
		<div class={ "page wrap", narrowPage }>
			@label("") {
				Account
			}
			<div class="mt-3 flex items-center gap-4">
				@avatar(account.avatar, account.login, avatarLG)
				<div class="min-w-0">
					<h1 class="title-xl truncate">{ account.login }</h1>
					if account.testUser {
						<p class="text-[14px] text-muted">Local test user, signed in without GitHub</p>
					} else {
						<p class="text-[14px] text-muted">Signed in with GitHub as <a class="rounded-[3px]" href={ templ.SafeURL(account.profileURL) }>{ account.login }</a></p>
					}
				</div>
			</div>
			<section class="mt-10" aria-labelledby="kept">
				@labelHeading("mb-3") {
					<span id="kept">What Rulemart keeps</span>
				}
				<dl class="grid gap-2.5 rounded-card border border-border px-4 py-3.5 text-[14px]">
					@fact("GitHub user ID") {
						<span class="font-mono text-[.86em]">{ account.gitHubUserID }</span>
					}
					@fact("Username") {
						{ account.login }
					}
					@fact("Avatar") {
						if account.avatar != "" {
							Your GitHub avatar
						} else {
							<span class="text-faint">None</span>
						}
					}
					@fact("Account created") {
						{ account.since }
					}
				</dl>
				<p class="mt-3 text-[13.5px] text-muted">Rulemart updates your username and avatar each time you sign in, and keeps nothing else from GitHub. Each browser stays signed in for 30 days, or until you sign out. <a href={ templ.SafeURL(privacyHref) }>Privacy</a></p>
				if visitorOf(ctx).stars {
					<p class="mt-2 text-[13.5px] text-muted">For your stars, it keeps which rules you starred, and when. Only you see the list; everyone sees how many stars each rule has. <a href={ templ.SafeURL(starredHref) }>Starred rules</a></p>
				}
				if visitorOf(ctx).cart {
					<p class="mt-2 text-[13.5px] text-muted">For your cart, it keeps what you add until you remove it, and shows it to no one else. <a href={ templ.SafeURL(cartHref) }>Your cart</a></p>
				}
				if visitorOf(ctx).listings {
					<p class="mt-2 text-[13.5px] text-muted">It also keeps which libraries you list, and when you listed or retried them, and shows no one else who listed them. <a href={ templ.SafeURL(listingsHref) }>Your listings</a></p>
				}
			</section>
			<section class="mt-10" aria-labelledby="sign-out">
				@labelHeading("mb-3") {
					<span id="sign-out">Sign out</span>
				}
				<div class="flex flex-wrap gap-2.5">
					<form method="post" action={ templ.SafeURL(signOutHref) }>
						<button class={ outlineButtonStyle } type="submit">Sign out</button>
					</form>
					<form method="post" action={ templ.SafeURL(signOutEverywhereHref) }>
						<button class={ outlineButtonStyle } type="submit">Sign out everywhere</button>
					</form>
				</div>
				<p class="mt-3 text-[13.5px] text-muted">Signing out everywhere signs you out of Rulemart in every browser, this one too.</p>
			</section>
			<section class="mt-10 border-t border-border-subtle pt-8" aria-labelledby="delete">
				@labelHeading("mb-3") {
					<span id="delete">Delete your account</span>
				}
				<details class="group">
					<summary class="-mx-1.5 inline-flex min-h-10 cursor-pointer list-none items-center gap-1.5 rounded-md px-1.5 text-[14px] text-muted hover:text-ink [&::-webkit-details-marker]:hidden">
						<svg class="size-3.5 shrink-0 group-open:rotate-90" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="m6 3.5 4.5 4.5L6 12.5"></path>
						</svg>
						<span class="underline underline-offset-4">What deleting does</span>
					</summary>
					<div class="mt-3 rounded-card border border-border-strong px-4 py-4">
						<p class="text-[14px] text-ink">Rulemart deletes your account and everything it keeps about you, and signs you out everywhere. It removes your stars, your cart, and your listings, so libraries you listed that Rulemart hasn't vetted leave it. Your GitHub account doesn't change. Signing in again starts a new account.</p>
						<form class="mt-4" method="post" action={ templ.SafeURL(deleteAccountHref) }>
							<button class={ dangerButtonStyle } type="submit">Delete my account</button>
						</form>
					</div>
				</details>
			</section>
		</div>
	}
}
