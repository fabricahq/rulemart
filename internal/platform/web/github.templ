// What a page that shows the visitor's GitHub account says of it.

package web

// gitHubStatus says how fresh Rulemart's read of the visitor's GitHub account is, for the page whose sections follow:
// when Rulemart last read it, with Refresh, that the last read failed, that it's making the first read now, or that
// the visitor must sign in again for Rulemart to read it. class places it on the page.
templ gitHubStatus(g gitHubView, class string) {
	if g.available {
		<div class={ class, "flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-faint" } data-github-status>
			switch {
				case g.signInAgain != "":
					<span class="text-ink">Sign in again so Rulemart can read your repositories on GitHub.</span>
					<a class={ linkButtonStyle } href={ templ.SafeURL(g.signInAgain) }>Sign in again</a>
				case g.failed:
					<span class="text-ink" role="status">
						Rulemart couldn't read your repositories on GitHub just now.
						if g.readAt != "" {
							Showing what it read { g.readAt }.
						}
					</span>
					@refreshButton(g.refresh, "Try again")
				case g.reading:
					<span class="text-ink" role="status">Rulemart is reading your repositories on GitHub. This page will update in a moment.</span>
				case g.readAt != "":
					<span>Read from GitHub { g.readAt }.</span>
					@refreshButton(g.refresh, "Refresh")
			}
			@truncatedRead(g)
		</div>
	}
}

// truncatedRead says, on a line of its own in a GitHub status's row, when the read left repositories out.
templ truncatedRead(g gitHubView) {
	if g.snapshot.Truncated {
		<span class="basis-full">Some of your repositories are left out: Rulemart reads the 200 most recently pushed of yours and your first 100 organizations'.</span>
	}
}

// refreshButton reads the visitor's GitHub account again, labeled label.
templ refreshButton(action, label string) {
	<form method="post" action={ templ.SafeURL(action) }>
		<button class={ linkButtonStyle } type="submit">{ label }</button>
	</form>
}

// summaryWords is how a gitHubSummary names what it reads: the sentence that says private ones are included, and the
// link that includes them.
type summaryWords struct{ including, include string }

var (
	// projectWords are the words of the dashboard's tabs, which read the visitor's projects.
	projectWords = summaryWords{including: "Including private projects from the repos you selected", include: "Include private projects"}
	// repoWords are the words of Add a library, which reads the visitor's libraries' repositories.
	repoWords = summaryWords{including: "Including private repos from the ones you selected", include: "Include private repos"}
)

// gitHubSummary ends a page that shows what Rulemart read of the visitor's GitHub account, in one line, class places
// it below what it describes: whether the read includes private repositories, when it was, with Refresh, and the way
// to include or manage private ones, in words. While Rulemart can't show a read, the line says why instead, as
// gitHubStatus does. Its children, such as a footnote, follow it.
templ gitHubSummary(g gitHubView, words summaryWords, class string) {
	if g.available {
		<div class={ class }>
			if g.signInAgain != "" || g.failed || g.reading {
				@gitHubStatus(g, "")
			} else {
				<div class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[12px] text-faint" data-github-status>
					if g.private {
						<span>{ words.including }</span>
					} else {
						<span>Public repos only</span>
					}
					if g.readAt != "" {
						<span>·</span>
						<span>read from GitHub { g.readAt }</span>
						<span>·</span>
						@refreshButton(g.refresh, "Refresh")
					}
					if g.private {
						<span>·</span>
						<a class={ linkButtonStyle } href={ templ.SafeURL(privateHref) }>Manage</a>
					} else if g.privateAvailable {
						<span>·</span>
						<a class={ linkButtonStyle } href={ templ.SafeURL(privateHref) }>{ words.include }</a>
					}
					@truncatedRead(g)
				</div>
			}
			{ children... }
		</div>
	}
}
