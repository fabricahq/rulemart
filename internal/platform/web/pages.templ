// The pages: the libraries, a library, a rule, and the pages for a missing page or a failure. home.templ holds the home
// page, and browse.templ, groups.templ, and search.templ the pages across libraries.

package web

import (
	"strconv"

	"github.com/fabricahq/rulemart/internal/contexts/catalog/domain"
)

// librariesPage lists every vetted library, and the unvetted ones too when unvetted is true, under a lede that says
// anyone can list a public library, leading to listing one when canList is true, and where the unvetted ones are, and
// the control that includes them.
templ librariesPage(c chrome, libraries []libraryCard, unvetted, canList bool) {
	@layout(c, head{title: "Libraries · Rulemart", description: "Every vetted Code Rules library: the engineering rules coding agents follow while they write and review your code.", section: librariesHref, noindex: unvetted, filters: true}) {
		<div class="page wrap">
			@label("") {
				Libraries
			}
			<h1 class="title-xl mt-2.5 mb-2">
				if unvetted {
					Every library on Rulemart
				} else {
					Libraries Rulemart has vetted
				}
			</h1>
			<p class="mb-[22px] max-w-[46rem] text-muted">
				if canList {
					Anyone can <a href={ templ.SafeURL(listHref) }>list a public library</a>.
				} else {
					Anyone can list a public library.
				}
				It shows, with a warning, under <a href={ templ.SafeURL(unvettedHref) } rel="nofollow">unvetted libraries</a> until Rulemart reviews and vets it. Each library shows its owner and repository, so you can see who stands behind it.
			</p>
			<div class="mb-4">
				@unvettedOptIn(librariesHref, unvetted)
			</div>
			if len(libraries) == 0 {
				<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">No libraries yet.</div>
			} else {
				@rowList() {
					for _, lib := range libraries {
						@rowItem() {
							@libraryRow(lib, false)
						}
					}
				}
			}
		</div>
	}
}

// libraryTab names a tab of a library's page.
type libraryTab string

const (
	groupsTab   libraryTab = "groups"
	rulesTab    libraryTab = "rules"
	releasesTab libraryTab = "releases"
)

// libraryPage shows a library's groups, with selection ticked, beside the box that adds them to the cart, or with
// rulesTab its rules by group, with its retired rules in place when retired is true, beside its facts.
templ libraryPage(c chrome, lib libraryView, contents libraryContents, current libraryTab, selection groupSelection, retired bool) {
	@libraryFrame(c, head{title: lib.owner + "/" + lib.name + " · Rulemart", description: lib.summary(), filters: current == rulesTab}, lib, current, libraryAside(lib, current, selection)) {
		if current == rulesTab {
			@allRules(lib, contents, retired)
		} else {
			@groupList("Technologies", lib, ofKind(contents.current(), techsKind), selection)
			@groupList("Practices", lib, ofKind(contents.current(), practicesKind), selection)
		}
	}
}

// libraryAside is what a library's page shows beside its tab: on the Groups tab, the box that adds the ticked groups,
// selection, to the cart, then the library's facts.
templ libraryAside(lib libraryView, current libraryTab, selection groupSelection) {
	if current == groupsTab {
		@groupsCartPanel(lib, selection)
	}
	@libraryFacts(lib)
}

// libraryFrame is every page about a library, as the prototype's library page: its owner's large avatar, with the
// check mark when it's vetted, its name, description, and a link to GitHub, its tabs with current on, and the tab's
// content, beside aside, unless it's nil, under the warning when the library isn't vetted. Discussion's tab will
// follow Library releases, with rulemart#27.
templ libraryFrame(c chrome, h head, lib libraryView, current libraryTab, aside templ.Component) {
	@layout(c, libraryHead(h, lib)) {
		<div class="page wrap">
			if !lib.vetted {
				@unvettedWarning(false)
			}
			<div class="grid grid-cols-[56px_minmax(0,1fr)_auto] items-start gap-[18px] max-narrow:grid-cols-[56px_minmax(0,1fr)]">
				@libraryAvatar(lib.avatar, lib.owner, avatarLG, lib.vetted)
				<div class="min-w-0">
					<h1 class="title-xl flex flex-wrap items-center gap-2.5">
						{ lib.name }
						if lib.vetted {
							<span class="sr-only">{ vettedTitle }</span>
						}
					</h1>
					if lib.description != "" {
						<p class="mt-1.5 mb-2.5 text-muted">{ lib.description }</p>
					}
				</div>
				<div class="flex flex-wrap items-center gap-2.5 max-narrow:col-span-full">
					@smallButton(lib.githubURL) {
						@githubMark("size-[15px] flex-none")
						View on GitHub
					}
				</div>
			</div>
			@tabs([]tab{
				{name: "Groups", href: lib.href, count: lib.groups, on: current == groupsTab},
				{name: "All rules", href: lib.href + "?tab=rules", count: lib.rules, on: current == rulesTab},
				{name: "Library releases", href: releasesHref(lib), count: lib.releases, on: current == releasesTab},
			})
			if aside != nil {
				<div class="grid grid-cols-[minmax(0,1fr)_300px] gap-9 max-wide:grid-cols-1">
					<div class="min-w-0">
						{ children... }
					</div>
					<aside class="grid content-start gap-[18px]">
						@aside
					</aside>
				</div>
			} else {
				{ children... }
			}
		</div>
	}
}

// groupList lists one kind of group, as the prototype's Groups tab: each row a label that ticks the group, with
// selection's ticked, for the Add to cart box of its library, which shades the row and marks its edge while ticked,
// showing the group's icon, name, and ID, or its ID flagged as not canonical, a practice's blurb, the In cart badge
// once the cart holds it, and its rules, leading to its page in the library with the selection.
templ groupList(kind string, lib libraryView, groups []groupView, selection groupSelection) {
	if len(groups) > 0 {
		@labelHeading("mt-[22px] mb-2 first:mt-0") {
			{ kind } · { strconv.Itoa(len(groups)) }
		}
		@rowList() {
			for _, g := range groups {
				@rowItem() {
					<label class="grid cursor-pointer grid-cols-[20px_minmax(150px,220px)_minmax(0,1fr)_auto] items-center gap-[14px] px-4 py-3 transition-colors duration-[120ms] hover:bg-surface has-[[data-cart-pick-group]:disabled]:cursor-default has-[[data-cart-pick-group]:checked:enabled]:bg-surface has-[[data-cart-pick-group]:checked:enabled]:shadow-[inset_3px_0_var(--ink)] max-narrow:grid-cols-[20px_minmax(0,1fr)_auto]">
						<span class="grid place-items-center">
							@groupPick(lib, g, selection.has(g.label.id))
						</span>
						<span class="flex min-w-0 items-center gap-2.5">
							@groupTile(g.label, g.icon, tileMD)
							<span class="min-w-0">
								<b class="block text-[14px] leading-[1.65] font-semibold">
									if g.label.canonical {
										{ g.label.name }
									} else {
										@breakable(g.label.id)
									}
								</b>
								<span class="block">
									if g.label.canonical {
										<span class="font-mono text-[12px] text-faint">
											@breakable(g.label.id)
										</span>
									} else {
										@notCanonical(flagMD)
									}
								</span>
							</span>
						</span>
						<p class="text-[13px] text-muted max-narrow:col-start-2 max-narrow:col-end-[-1] max-narrow:row-start-2 max-narrow:empty:hidden">
							{ g.shownBlurb() }
						</p>
						// On a phone the In cart chip goes under the rule count, so the group's ID keeps the width it needs.
						<span class="inline-flex items-center gap-2 text-[12.5px] whitespace-nowrap text-faint max-narrow:col-start-3 max-narrow:row-start-1 max-narrow:flex-col-reverse max-narrow:items-end max-narrow:gap-1">
							@groupHeldBadge(lib, g)
							<a class="text-muted no-underline underline-offset-3 hover:text-ink hover:underline" href={ templ.SafeURL(libraryGroupHref(lib.href, g.label.id) + selection.query()) } data-sel-link={ libraryGroupHref(lib.href, g.label.id) }>{ plural(len(g.rules), "rule", "rules") } ›</a>
						</span>
					</label>
				}
			}
		}
	}
}

// libraryGroupPage shows one group of a library, as the prototype's library group page: where it is, its icon and
// name, its rules, the way back to the library's groups, and the Whole group box that adds the group to the cart.
// selection is the groups the library's Groups tab ticks, which its links back carry.
templ libraryGroupPage(c chrome, lib libraryView, g groupView, selection groupSelection) {
	@layout(c, libraryHead(head{title: g.label.display() + " · " + lib.fullName() + " · Rulemart", description: lib.fullName() + ": " + plural(len(g.rules), g.label.display()+" rule", g.label.display()+" rules") + " for coding agents, in a Code Rules library on Rulemart."}, lib)) {
		<div class="page wrap">
			if !lib.vetted {
				@unvettedWarning(false)
			}
			<div class="mb-[14px] flex flex-wrap items-center gap-1.5 text-[13px] text-faint">
				@libraryCrumb(lib, lib.href+selection.query())
				<span>›</span>
				<span class="mono">{ g.label.id }</span>
			</div>
			<h1 class="title-xl flex flex-wrap items-center gap-[14px]">
				@groupTile(g.label, g.icon, tileTitle)
				{ g.label.display() }
				if !g.label.canonical {
					@notCanonical(flagMD)
				}
			</h1>
			<p class="mt-2 mb-6 text-muted">
				{ plural(len(g.rules), "rule", "rules") } in { lib.fullName() }
				if blurb := g.shownBlurb(); blurb != "" {
					{ "· " + blurb }
				}
			</p>
			<div class="grid grid-cols-[minmax(0,1fr)_300px] gap-9 max-wide:grid-cols-1">
				<div class="min-w-0">
					@ruleRows() {
						for _, r := range g.rules {
							@ruleRow(r)
						}
					}
					<a class="mt-6 inline-block text-[13px] text-muted hover:text-ink" href={ templ.SafeURL(lib.href + selection.query()) }>← Back to all groups in { lib.fullName() }</a>
				</div>
				<aside class="grid content-start">
					<div class="rounded-panel border border-border bg-paper p-[18px] wide:sticky wide:top-[84px]">
						@label("mb-1.5") {
							Whole group
						}
						<p class="mb-[14px] text-[13px] text-muted">Adds all { plural(len(g.rules), g.label.display()+" rule", g.label.display()+" rules") } from <span>
							// The name wraps after its slash rather than leave "from" alone at a line's end.
							@breakable(lib.fullName() + ".")
						</span>{ " " }@groupUpdates(lib)</p>
						@groupCartControl(lib, g)
						if g.label.canonical {
							<p class="mt-4 text-[13px]"><a href={ templ.SafeURL(g.acrossHref) }>See { g.label.display() } rules from every library →</a></p>
						}
					</div>
				</aside>
			</div>
		</div>
		@confirmDialog(lib)
	}
}

// allRules lists every current rule under its group, as the prototype's All rules tab, and when retired is true, each
// group's retired rules after its current ones, grayed out, with the control that shows them when the library has any,
// a one-checkbox form as the unvetted opt-in is.
templ allRules(lib libraryView, contents libraryContents, retired bool) {
	if contents.hasRetired || retired {
		<div class="mb-4">
			@optInForm(lib.href, domain.RetiredParam, "Show retired rules", retired) {
				<input type="hidden" name="tab" value={ string(rulesTab) }/>
			}
		</div>
	}
	for _, g := range contents.all() {
		if len(g.rules) > 0 || (retired && len(g.retired) > 0) {
			<h2 class="mt-[30px] flex scroll-mt-20 flex-wrap items-center gap-x-1.5 gap-y-1 border-b border-border px-0.5 pb-[7px] text-[11px] tracking-[.1em] text-faint uppercase first-of-type:mt-0" id={ g.anchor }>
				if g.label.canonical {
					{ g.label.name } <span class="mono tracking-normal normal-case">{ g.label.id }</span>
				} else {
					<span class="mono tracking-normal normal-case">{ g.label.id }</span>
					@notCanonical(flagSM)
				}
			</h2>
			@ruleRows() {
				for _, r := range g.rules {
					@ruleRow(r)
				}
				if retired {
					for _, r := range g.retired {
						@ruleRow(r)
					}
				}
			}
		}
	}
}

// ruleTab names a tab of a rule's page.
type ruleTab string

const (
	contentTab  ruleTab = "rule"
	versionsTab ruleTab = "versions"
)

// rulePage shows a rule's current version, or with versionsTab every version, newest first. A retired rule's page
// shows how it was retired and its versions instead.
templ rulePage(c chrome, r ruleView, current ruleTab) {
	@ruleFrame(c, head{title: r.title + " · " + r.library.owner + "/" + r.library.name + " · Rulemart", description: r.summary()}, r, current) {
		if r.retired != nil {
			@retiredRule(r)
		} else if current == versionsTab {
			@versions(r)
		} else {
			@ruleContent(r)
		}
	}
}

// ruleFrame is every page about a rule: where it is in its library, its title, its star control while it's a current
// rule of a vetted library, its tabs with current on while it's current, and the tab's content, under the warning when
// the library isn't vetted.
templ ruleFrame(c chrome, h head, r ruleView, current ruleTab) {
	@layout(c, ruleHead(h, r)) {
		<div class="page wrap">
			if !r.library.vetted {
				@unvettedWarning(false)
			}
			@ruleCrumbs(r) {
				if r.group.canonical {
					<span class="mono">{ r.group.id }</span>
				} else {
					@notCanonical(flagSM)
				}
			}
			<div class="flex flex-wrap items-start justify-between gap-6">
				<div class="min-w-0">
					<h1 class="title-xl max-w-[44rem]">{ r.title }</h1>
					<div class="mt-2.5 flex flex-wrap items-center gap-x-[14px] gap-y-1.5 text-[13px] text-muted">
						if r.retired != nil {
							<span class="rounded-full border border-border-strong px-2.5 text-[12px] font-medium text-ink">Retired</span>
							<span>Last version <span class="mono">{ r.version }</span></span>
						} else {
							@impactLink(r.impact)
							<span class="mono" title="Latest version">{ r.version }</span>
							for _, t := range r.tags {
								<a class="text-faint no-underline underline-offset-3 hover:text-ink hover:underline" href={ templ.SafeURL(t.href) } title="Search this tag">#{ t.text }</a>
							}
						}
					</div>
					if r.retired == nil && r.star.shown {
						// The prototype's engage row: Star, then Discuss, which comes with rulemart#27. Without a Star control, as
						// in an unvetted library, it holds nothing yet, so it goes rather than leave a gap.
						<div class="mt-[14px] flex min-h-8 flex-wrap items-center gap-2" data-engage>
							@starControl(r.star)
						</div>
					}
				</div>
				if r.retired == nil {
					@ruleCartControl(r)
				}
			</div>
			// Discussion's tab comes between Rule and Versions with rulemart#27.
			if r.retired == nil {
				@tabs([]tab{
					{name: "Rule", href: r.href, count: -1, on: current == contentTab},
					{name: "Versions", href: r.href + "?tab=versions", count: len(r.versions), on: current == versionsTab},
				})
			} else {
				<div class="mt-[26px]"></div>
			}
			{ children... }
		</div>
	}
}

// ruleCrumbs is where a rule is, at the top of its pages: its library's avatar and name, then its group's icon and
// name, which lead to the group across libraries, then what the children add.
templ ruleCrumbs(r ruleView) {
	<div class="mb-[14px] flex flex-wrap items-center gap-1.5 text-[13px] text-faint">
		@libraryCrumb(r.library, r.library.href)
		<span>›</span>
		@groupTile(r.group, r.groupIcon, tileXS)
		<a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(r.acrossHref) }>
			if r.group.canonical {
				{ r.group.name }
			} else {
				<span class="mono">{ r.group.id }</span>
			}
		</a>
		{ children... }
	</div>
}

// libraryCrumb is a library at the start of a page's crumbs: its owner's avatar, with the check mark when Rulemart vets
// it, and its name, leading to href, its page.
templ libraryCrumb(lib libraryView, href string) {
	@libraryAvatar(lib.avatar, lib.owner, avatarSM, lib.vetted)
	<a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(href) }>{ lib.name }</a>
}

// retiredRule says when and why a library release retired a rule, and what replaced it, then shows its last
// version's text and lists its versions.
templ retiredRule(r ruleView) {
	<div class="mb-7 rounded-[10px] border border-l-[3px] border-border border-l-border-strong bg-surface px-[18px] py-[14px] text-[14px]">
		<p><b class="font-semibold">Retired in</b> <a class={ releaseTagClass } href={ templ.SafeURL(r.retired.href) }>{ r.retired.tag }</a> <span class="text-faint">· { r.retired.date }</span></p>
		for _, summary := range r.retired.summaries {
			<p class="mt-1 text-muted">{ summary }</p>
		}
		if len(r.retired.replacedBy) > 0 {
			<p class="mt-1.5">
				@replacementChain(headChainSteps(r.retired.replacedBy, r.retired.renamed), true)
			</p>
		}
		<p class="mt-1.5 text-[13px] text-faint">Projects that pin it keep its last version. Other projects drop it when they update.</p>
	</div>
	if r.html != "" {
		<section aria-labelledby="last-text">
			<div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
				@labelHeading("") {
					<span id="last-text">Text of version <span class="mono tracking-normal normal-case">{ r.version }</span></span>
				}
				@githubLink(r.fileURL, "View on GitHub", r.fileName+" at "+r.version+" on GitHub")
			</div>
			<div class="prose mb-9 max-w-[52rem]">
				@templ.Raw(r.html)
			</div>
		</section>
	}
	@labelHeading("mb-2") {
		Versions · { strconv.Itoa(len(r.versions)) }
	}
	@versionList(r)
}

// replacesNotes say which retired rules the rule replaced, or renamed.
templ replacesNotes(r ruleView) {
	if r.renamedFrom != nil {
		<div class="mb-[14px] rounded-[10px] border border-dashed border-border-strong px-[14px] py-2.5 text-[13px] text-muted">
			Renamed from <a href={ templ.SafeURL(r.renamedFrom.rule.href) }>{ r.renamedFrom.rule.id }</a> in <a class={ releaseTagClass } href={ templ.SafeURL(r.renamedFrom.tagHref) }>{ r.renamedFrom.tag }</a>.
		</div>
	}
	for _, replaced := range r.replaces {
		<div class="mb-[14px] rounded-[10px] border border-dashed border-border-strong px-[14px] py-2.5 text-[13px] text-muted">
			Replaces <a href={ templ.SafeURL(replaced.rule.href) }>{ replaced.rule.title }</a> <span class="mono text-faint">{ replaced.rule.id }</span>, retired in <a class={ releaseTagClass } href={ templ.SafeURL(replaced.tagHref) }>{ replaced.tag }</a>.
		</div>
	}
}

// ruleContent is a current rule's Rule tab, as the prototype's: what it replaced, when to apply it and its text, and
// beside them, the About panel, its assets, when it has any, and its facts.
templ ruleContent(r ruleView) {
	@replacesNotes(r)
	<div class="grid grid-cols-[minmax(0,1fr)_280px] gap-9 max-wide:grid-cols-1">
		<div class="prose min-w-0">
			<div class="when-to-apply mb-5 border-l-2 border-border-strong py-0.5 pl-[14px] text-[14px] text-muted">
				<b class="mb-0.5 block text-[11px] font-semibold tracking-[.1em] text-ink uppercase">When to apply</b>
				if r.whenToReadHTML != "" {
					@templ.Raw(r.whenToReadHTML)
				} else {
					{ r.whenToRead }
				}
			</div>
			@templ.Raw(r.html)
		</div>
		<aside class="grid content-start gap-[18px]">
			@ruleAbout(r)
			if len(r.assets) > 0 {
				@assetsPanel(r.assets)
			}
			<dl class="grid grid-cols-[minmax(0,1fr)] gap-[7px] text-[13px]">
				@libraryOwnership(r.library)
				@kv("File") {
					// A long name keeps one line, cut from its start, so its end, which tells rules apart, shows, and the
					// whole path shows on hover.
					<span class="block truncate [direction:rtl]"><a class="font-mono text-[.86em]" href={ templ.SafeURL(r.fileURL) } title={ r.id + ".md" }><bdi>{ r.fileName }</bdi></a></span>
				}
			</dl>
		</aside>
	</div>
}

// ruleAbout is a rule's About panel, as the prototype's: who publishes it, how fresh it is, and where to ask about it,
// which leads to its library's issues on GitHub until Discuss comes with rulemart#27.
templ ruleAbout(r ruleView) {
	@sidePanel("About", "about", nil) {
		<div class="grid gap-[14px] px-[18px] py-4">
			<a class="group flex items-center gap-2.5 text-ink no-underline" href={ templ.SafeURL(r.library.href) }>
				@libraryAvatar(r.library.avatar, r.library.owner, avatarMD, r.library.vetted)
				<span class="grid min-w-0 gap-px">
					<span class="text-[14px] font-medium underline-offset-3 group-hover:underline [overflow-wrap:anywhere]">{ r.library.name }</span>
					<span class="text-[12px] text-faint">Published by { publisher(r.library.owner) }</span>
				</span>
			</a>
			<div class="flex justify-between gap-3 border-t border-border pt-3 text-[13px]">
				<span class="text-muted">Updated</span>
				<span>{ r.updated }</span>
			</div>
			<div class="border-t border-border pt-3">
				<p class="text-[13px] text-muted">Questions or suggestions? <a class="whitespace-nowrap" href={ templ.SafeURL(r.library.githubURL + "/issues") }>Ask on GitHub</a></p>
			</div>
		</div>
	}
}

// versions lists every version of a rule, newest first, with what it replaced and a way to compare its versions.
templ versions(r ruleView) {
	@replacesNotes(r)
	<h2 class="sr-only">Versions</h2>
	<p class="mb-[14px] text-[13px] text-faint">
		A version describes what work must do to comply with the rule. <b>Major:</b> work that complied with the previous version could fail this one. <b>Minor:</b> it still complies, and this version adds guidance. <b>Patch:</b> it still complies, and nothing is added. <a href={ templ.SafeURL(versionsDocs) }>How versions work</a>
	</p>
	if r.compareHref != "" {
		<div class="mb-3 flex items-center justify-between gap-4">
			<span class="text-[13px] text-faint">{ plural(len(r.versions), "version", "versions") }</span>
			@smallButton(r.compareHref) {
				Compare versions
			}
		</div>
	}
	@versionList(r)
}

// versionList lists every version of a rule, newest first, each under its own heading, leading to its library
// release and comparing it with the version before.
templ versionList(r ruleView) {
	@rowList() {
		for _, v := range r.versions {
			@rowItem() {
				<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 px-[18px] py-[14px] max-narrow:grid-cols-1 max-narrow:gap-2.5">
					<div class="min-w-0">
						<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
							<h3 class="mono font-semibold">{ v.version }</h3>
							if v.latest {
								@latestBadge()
							}
							if v.major {
								@majorMark()
							}
							@releaseTagLink(v.releaseHref, v.tag)
							<span class="text-[13px] text-faint">{ v.date }</span>
						</div>
						<div class="mt-1">
							for _, summary := range v.summaries {
								<div class="text-[13px] text-muted">{ summary }</div>
							}
						</div>
					</div>
					// Each row's button is as wide as the widest a version usually needs, so their edges line up.
					<div class="grid grid-cols-[auto_auto] items-center gap-[14px] max-narrow:flex max-narrow:flex-wrap">
						<span class="max-narrow:empty:hidden narrow:min-w-[10.5rem] narrow:[&>a]:w-full">
							if v.compareHref != "" {
								@smallGhostButton(v.compareHref) {
									Compare with { v.previous }
								}
							}
						</span>
						@versionNotesLink(v.notesURL, v.tag)
					</div>
				</div>
			}
		}
	}
}

// releaseTagLink leads to a library release, named by its tag, on the Library releases tab.
templ releaseTagLink(href, tag string) {
	<a class={ releaseTagClass } href={ templ.SafeURL(href) }>{ tag }</a>
}

// latestBadge marks a rule's latest version, or a library's latest release.
templ latestBadge() {
	<span class="inline-flex items-center rounded-full border border-border px-2 text-[11.5px] leading-[18px] font-medium whitespace-nowrap text-muted">Latest</span>
}

// majorMark flags a major change, and leads to what one means: work that complied with the previous version could
// fail the new one. It says so to assistive technology too, so no one needs to hover to learn it.
templ majorMark() {
	<a class="inline-flex items-center rounded-full border border-border-strong px-2 text-[11.5px] leading-[18px] font-medium whitespace-nowrap text-ink no-underline hover:bg-surface" href={ templ.SafeURL(versionsDocs) } title={ majorExplanation } aria-label={ majorExplanation + " How versions work." }>Major</a>
}

// messagePage is a page that only says what happened, such as for a missing page or a failure.
templ messagePage(c chrome, title, message string) {
	@layout(c, head{title: title + " · Rulemart"}) {
		<div class="page wrap">
			<h1 class="title-xl">{ title }</h1>
			<p class="mt-2.5 text-muted">{ message } <a href="/">Go home</a>.</p>
		</div>
	}
}
