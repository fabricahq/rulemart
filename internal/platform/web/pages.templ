// The pages: home, a library, a rule, and the pages for a missing page or a failure. groups.templ and search.templ
// hold the pages across libraries.

package web

import "strconv"

// homePage leads with search, then lists the vetted libraries, and the canonical groups they hold.
templ homePage(c chrome, libraries []libraryCard, groups groupIndexView) {
	@layout(c, head{title: "Rulemart: Code Rules libraries", description: "Find and adopt Code Rules libraries: the engineering rules coding agents follow while they write and review your code."}) {
		<section class="wrap pt-20 pb-12 text-center max-narrow:pt-14 max-narrow:pb-9">
			@label("") {
				The Code Rules library catalog
			}
			<h1 class="mt-[22px] mb-[18px] text-[clamp(2.25rem,4.6vw,3.6rem)] leading-[1.08] font-normal tracking-[-.06em]">
				Agent coding best practices,{ " " }
				<br class="max-narrow:hidden"/>
				off the shelf
			</h1>
			<p class="mx-auto max-w-[50rem] text-[18px] text-balance text-muted">No need to reinvent the wheel. Pick proven rules from other teams and add them straight to your codebase.</p>
			<div class="mx-auto mt-8 max-w-[36rem] text-left">
				@searchForm("home-search", "", false)
			</div>
		</section>
		<section class="border-t border-border-subtle py-11">
			<div class="wrap">
				<div class="mb-[18px] flex items-baseline justify-between gap-4 max-narrow:flex-wrap">
					<h2 class="text-[1.6rem] font-medium tracking-[-.045em] max-narrow:text-[1.35rem]">Libraries</h2>
				</div>
				if len(libraries) == 0 {
					<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">No libraries yet.</div>
				} else {
					@rowList() {
						for _, lib := range libraries {
							@rowItem() {
								@libraryRow(lib)
							}
						}
					}
				}
			</div>
		</section>
		if !groups.empty() {
			<section class="border-t border-border-subtle py-11">
				<div class="wrap">
					<div class="mb-[18px] flex items-baseline justify-between gap-4">
						<h2 class="text-[1.6rem] font-medium tracking-[-.045em] max-narrow:text-[1.35rem]">Browse by group</h2>
						<a class="text-[13px] whitespace-nowrap text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(groupsHref) }>All groups ›</a>
					</div>
					@groupTiles("Technologies", canonicalOnly(groups.techs))
					@groupTiles("Practices", canonicalOnly(groups.practices))
				</div>
			</section>
		}
	}
}

// groupTiles shows one kind of canonical group as a grid of tiles, each leading to its page.
templ groupTiles(kind string, groups []groupSummaryView) {
	if len(groups) > 0 {
		@labelSubheading("mt-[22px] mb-2 first:mt-0") {
			{ kind }
		}
		<div class="grid grid-cols-[repeat(auto-fill,minmax(12rem,1fr))] gap-2.5 max-narrow:grid-cols-2">
			for _, g := range groups {
				<a class="flex min-w-0 items-center gap-3 rounded-card border border-border px-3.5 py-3 text-ink no-underline transition-colors duration-[120ms] hover:border-border-strong hover:bg-surface" href={ templ.SafeURL(g.href) }>
					@groupTile(g.label, g.icon, tileMD)
					<span class="grid min-w-0">
						<span class="text-[14px] leading-[20px] font-semibold">{ g.label.name }</span>
						<span class="text-[12.5px] leading-[18px] text-muted">{ plural(g.rules, "rule", "rules") }</span>
					</span>
				</a>
			}
		</div>
	}
}

templ libraryRow(lib libraryCard) {
	<a class="group grid grid-cols-[minmax(0,1fr)_auto_14px] items-center gap-x-[18px] gap-y-3 px-[18px] py-[14px] text-ink no-underline transition-colors duration-[120ms] hover:bg-surface focus-visible:outline-offset-[-3px]" href={ templ.SafeURL(lib.href) }>
		<div class="flex items-start gap-[14px]">
			@avatar(lib.avatar, lib.owner, avatarMD)
			<div>
				<div class="leading-[1.35] font-semibold">{ lib.name }</div>
				if lib.description != "" {
					<div class="mt-0.5 text-[13px] text-muted">{ lib.description }</div>
				}
				<div class="mono mt-1 text-[12.5px] text-faint">
					@breakable(lib.owner + "/" + lib.name)
				</div>
			</div>
		</div>
		<span class="text-[12.5px] whitespace-nowrap text-muted max-narrow:col-start-1 max-narrow:row-start-2 max-narrow:-mt-3 max-narrow:pl-[54px]">{ plural(lib.rules, "rule", "rules") }</span>
		@chevron()
	</a>
}

// chevron appears at the end of a row while it's hovered or focused.
templ chevron() {
	<span class="-translate-x-1 text-[20px] leading-none text-faint opacity-0 transition duration-[120ms] group-hover:translate-x-0 group-hover:text-ink group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:text-ink group-focus-visible:opacity-100" aria-hidden="true">›</span>
}

// librariesPage lists every vetted library.
templ librariesPage(c chrome, libraries []libraryCard) {
	@layout(c, head{title: "Libraries · Rulemart", description: "Every vetted Code Rules library: the engineering rules coding agents follow while they write and review your code.", section: librariesHref}) {
		<div class="page wrap">
			<h1 class="title-xl">Libraries</h1>
			<p class="mt-1.5 max-w-[46rem] text-muted">Each library is a set of rules a team publishes for coding agents to follow. Rulemart lists only the libraries it has vetted.</p>
			<div class="mt-[26px]">
				if len(libraries) == 0 {
					<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">No libraries yet.</div>
				} else {
					@rowList() {
						for _, lib := range libraries {
							@rowItem() {
								@libraryRow(lib)
							}
						}
					}
				}
			</div>
		</div>
	}
}

// libraryTab names a tab of a library's page.
type libraryTab string

const (
	groupsTab   libraryTab = "groups"
	rulesTab    libraryTab = "rules"
	releasesTab libraryTab = "releases"
)

// libraryPage shows a library's groups, or with rulesTab its rules by group, beside its facts.
templ libraryPage(c chrome, lib libraryView, contents libraryContents, current libraryTab) {
	@libraryFrame(c, head{title: lib.owner + "/" + lib.name + " · Rulemart", description: lib.description, section: librariesHref}, lib, current, true) {
		if current == rulesTab {
			@allRules(contents)
		} else {
			@groupList("Technologies", lib, contents.techs)
			@groupList("Practices", lib, contents.practices)
		}
	}
}

// libraryFrame is every page about a library: its name, its tabs with current on, and the tab's content, beside the
// library's facts when withFacts.
templ libraryFrame(c chrome, h head, lib libraryView, current libraryTab, withFacts bool) {
	@layout(c, h) {
		<div class="page wrap">
			<div class="grid grid-cols-[56px_minmax(0,1fr)_auto] items-start gap-[18px] max-narrow:grid-cols-[56px_minmax(0,1fr)]">
				@avatar(lib.avatar, lib.owner, avatarLG)
				<div>
					<h1 class="title-xl"><span class="text-faint">{ lib.owner } /</span> <span class="inline-block">{ lib.name }</span></h1>
					if lib.description != "" {
						<p class="mt-1.5 mb-2.5 text-muted">{ lib.description }</p>
					}
				</div>
				<div class="flex flex-wrap items-center gap-2.5 max-narrow:col-span-full">
					@smallButton(lib.githubURL) {
						@githubMark("size-[15px] flex-none")
						View on GitHub
					}
				</div>
			</div>
			@tabs([]tab{
				{name: "Groups", href: lib.href, count: lib.groups, on: current == groupsTab},
				{name: "All rules", href: lib.href + "?tab=rules", count: lib.rules, on: current == rulesTab},
				{name: "Library releases", href: releasesHref(lib), count: lib.releases, on: current == releasesTab},
			})
			if withFacts {
				<div class="grid grid-cols-[minmax(0,1fr)_300px] gap-9 max-wide:grid-cols-1">
					<div class="min-w-0">
						{ children... }
					</div>
					<aside class="grid content-start gap-[18px]">
						@libraryFacts(lib)
					</aside>
				</div>
			} else {
				{ children... }
			}
		</div>
	}
}

// groupList lists one kind of group, each leading to its rules on the All rules tab, and a canonical group also to
// its page across libraries. The row's main link covers the row, and the second link sits above it.
templ groupList(kind string, lib libraryView, groups []groupView) {
	if len(groups) > 0 {
		@labelHeading("mt-[22px] mb-2 first:mt-0") {
			{ kind } · { strconv.Itoa(len(groups)) }
		}
		@rowList() {
			for _, g := range groups {
				@rowItem() {
					<div class="relative grid grid-cols-[minmax(190px,260px)_minmax(0,1fr)_auto] items-center gap-[14px] px-4 py-3 transition-colors duration-[120ms] hover:bg-surface has-[.row-link:focus-visible]:outline-3 has-[.row-link:focus-visible]:outline-offset-[-3px] has-[.row-link:focus-visible]:outline-(--focus) max-narrow:grid-cols-[minmax(0,1fr)_auto]">
						<div class="flex min-w-0 items-center gap-3">
							@groupTile(g.label, g.icon, tileMD)
							<div class="min-w-0">
								<a class="row-link block text-[14px] leading-[22px] font-semibold text-ink no-underline after:absolute after:inset-0 focus-visible:outline-none" href={ templ.SafeURL(lib.href + "?tab=rules#" + g.anchor) }>
									if g.label.canonical {
										{ g.label.name }
									} else {
										{ g.label.id }
									}
								</a>
								if g.label.canonical {
									<span class="block font-mono text-[12px] leading-[20px] text-faint">{ g.label.id }</span>
								} else {
									<span class="block leading-[20px]">
										@notCanonical(flagMD)
									</span>
								}
							</div>
						</div>
						<p class="text-[13px] text-muted max-narrow:col-span-full max-narrow:row-start-2 max-narrow:pl-10 max-narrow:empty:hidden">{ g.blurb }</p>
						<div class="grid justify-items-end gap-0.5 text-[12.5px] whitespace-nowrap text-muted max-narrow:col-start-2 max-narrow:row-start-1">
							<span>{ plural(len(g.rules), "rule", "rules") } ›</span>
							if g.acrossHref != "" {
								<a class="relative z-10 text-muted no-underline underline-offset-3 hover:text-ink hover:underline" href={ templ.SafeURL(g.acrossHref) } aria-label={ "All libraries' " + g.label.name + " rules" }>All libraries</a>
							}
						</div>
					</div>
				}
			}
		}
	}
}

// allRules lists every current rule under its group.
templ allRules(contents libraryContents) {
	for _, g := range contents.all() {
		<h2 class="mt-8 mb-3 flex scroll-mt-20 items-center gap-2 border-b border-border px-0.5 pb-[7px] text-[11px] tracking-[.1em] text-faint uppercase first:mt-0" id={ g.anchor }>
			@groupTile(g.label, g.icon, tileXS)
			if g.label.canonical {
				<span>{ g.label.name } <span class="mono tracking-normal normal-case">{ g.label.id }</span></span>
			} else {
				<span class="mono tracking-normal normal-case">{ g.label.id }</span>
				@notCanonical(flagSM)
			}
		</h2>
		@ruleCards() {
			for _, r := range g.rules {
				@ruleCardLink(r)
			}
		}
	}
	if len(contents.retired) > 0 {
		<h2 class="mt-8 mb-3 border-b border-border px-0.5 pb-[7px] text-[11px] tracking-[.1em] text-faint uppercase" id="retired">Retired</h2>
		@rowList() {
			for _, r := range contents.retired {
				@rowItem() {
					@retiredRuleRow(r)
				}
			}
		}
	}
}

// retiredRuleRow is a retired rule in the All rules tab, leading to its page.
templ retiredRuleRow(r retiredRuleCard) {
	<a class="group grid grid-cols-[minmax(0,1fr)_14px] items-center gap-[18px] px-[18px] py-3 text-ink no-underline transition-colors duration-[120ms] hover:bg-surface focus-visible:outline-offset-[-3px]" href={ templ.SafeURL(r.href) }>
		<div class="min-w-0">
			<div class="text-[14px] leading-[1.35] font-semibold">{ r.title }</div>
			<div class="mt-0.5 text-[12.5px] text-muted">
				<span class="mono text-faint">
					@breakable(r.id)
				</span> · last version <span class="mono">{ r.lastVersion }</span> · retired in <span class="mono">{ r.retiredTag }</span>
				if r.replacedBy != "" {
					· replaced by <span class="mono">
						@breakable(r.replacedBy)
					</span>
				}
			</div>
		</div>
		@chevron()
	</a>
}

// ruleTab names a tab of a rule's page.
type ruleTab string

const (
	contentTab  ruleTab = "rule"
	versionsTab ruleTab = "versions"
)

// rulePage shows a rule's current version, or with versionsTab every version, newest first. A retired rule's page
// shows how it was retired and its versions instead.
templ rulePage(c chrome, r ruleView, current ruleTab) {
	@ruleFrame(c, head{title: r.title + " · " + r.library.owner + "/" + r.library.name + " · Rulemart", description: r.whenToRead, section: librariesHref}, r, current) {
		if r.retired != nil {
			@retiredRule(r)
		} else if current == versionsTab {
			@versions(r)
		} else {
			@ruleContent(r)
		}
	}
}

// ruleFrame is every page about a rule: where it is in its library, its title, its tabs with current on while it's
// current, and the tab's content.
templ ruleFrame(c chrome, h head, r ruleView, current ruleTab) {
	@layout(c, h) {
		<div class="page wrap">
			<div class="mb-[14px] flex flex-wrap items-center gap-1.5 text-[13px] text-faint">
				@avatar(r.library.avatar, r.library.owner, avatarSM)
				<a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(r.library.href) }>{ r.library.name }</a>
				<span>›</span>
				if r.group.canonical {
					<a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(r.groupHref) }>{ r.group.name }</a>
					<span class="mono">{ r.group.id }</span>
				} else {
					<a class="mono text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(r.groupHref) }>{ r.group.id }</a>
					@notCanonical(flagSM)
				}
				if r.acrossHref != "" {
					<a class="ml-auto text-muted no-underline hover:text-ink hover:underline max-narrow:ml-0 max-narrow:basis-full" href={ templ.SafeURL(r.acrossHref) }>{ r.group.name } rules in all libraries ›</a>
				}
			</div>
			<div class="flex flex-wrap items-start justify-between gap-6">
				<div>
					<h1 class="title-xl max-w-[44rem]">{ r.title }</h1>
					<div class="mt-2.5 flex flex-wrap items-center gap-x-[14px] gap-y-1.5 text-[13px] text-muted">
						if r.retired != nil {
							<span class="rounded-full border border-border-strong px-2.5 text-[12px] font-medium text-ink">Retired</span>
							<span>Last version <span class="mono">{ r.version }</span></span>
						} else {
							@impact(r.impact)
							<span class="mono" title="Latest version">{ r.version }</span>
						}
					</div>
				</div>
			</div>
			if r.retired == nil {
				@tabs([]tab{
					{name: "Rule", href: r.href, count: -1, on: current == contentTab},
					{name: "Versions", href: r.href + "?tab=versions", count: len(r.versions), on: current == versionsTab},
				})
			} else {
				<div class="mt-[26px]"></div>
			}
			{ children... }
		</div>
	}
}


// retiredRule says when and why a library release retired a rule, and what replaced it, then lists its versions.
templ retiredRule(r ruleView) {
	<div class="mb-7 max-w-[52rem] rounded-[10px] border border-l-[3px] border-border border-l-border-strong bg-surface px-[18px] py-[14px] text-[14px]">
		<p><b class="font-semibold">Retired in <a class="mono font-normal" href={ templ.SafeURL(r.retired.href) }>{ r.retired.tag }</a></b> <span class="text-faint">· { r.retired.date }</span></p>
		for _, summary := range r.retired.summaries {
			<p class="mt-1 text-muted">{ summary }</p>
		}
		if r.retired.replacedBy != nil {
			<p class="mt-1.5">Replaced by <a href={ templ.SafeURL(r.retired.replacedBy.href) }><b class="font-semibold">{ r.retired.replacedBy.title }</b></a> <span class="mono text-faint">{ r.retired.replacedBy.id }</span></p>
		}
		<p class="mt-1.5 text-[13px] text-faint">Projects that pin it keep its last version. Other projects drop it when they update.</p>
	</div>
	@labelHeading("mb-2") {
		Versions · { strconv.Itoa(len(r.versions)) }
	}
	@versionList(r)
}

templ ruleContent(r ruleView) {
	<div class="grid grid-cols-[minmax(0,1fr)_280px] gap-9 max-wide:grid-cols-1">
		<div class="prose">
			<div class="when-to-apply mb-5 border-l-2 border-border-strong py-0.5 pl-[14px] text-[14px] text-muted">
				<b class="mb-0.5 block text-[11px] font-semibold tracking-[.1em] text-ink uppercase">When to apply</b>
				if r.whenToReadHTML != "" {
					@templ.Raw(r.whenToReadHTML)
				} else {
					{ r.whenToRead }
				}
			</div>
			@templ.Raw(r.html)
		</div>
		<aside class="grid content-start gap-[18px]">
			@aboutPanel(impactNote(r.impact)) {
				@fact("Library") {
					<a class="inline-flex items-start gap-1.5 text-right" href={ templ.SafeURL(r.library.href) }>
						@avatar(r.library.avatar, r.library.owner, avatarXS)
						<span class="min-w-0">
							@breakable(r.library.owner + "/" + r.library.name)
						</span>
					</a>
				}
				@fact("Repository") {
					@factLink(r.library.githubURL, r.library.name, "github.com/"+r.library.owner+"/"+r.library.name)
				}
				@fact("License") {
					@license(r.library)
				}
				@fact("File") {
					@factLink(r.fileURL, r.fileName, r.id+".md")
				}
				@fact("Updated") {
					{ r.updated }
				}
				@fact("Impact") {
					@impact(r.impact)
				}
			}
		</aside>
	</div>
}

// versions lists every version of a rule, newest first, with what it replaced and a way to compare its versions.
templ versions(r ruleView) {
	for _, replaced := range r.replaces {
		<div class="mb-[14px] rounded-[10px] border border-dashed border-border-strong px-[14px] py-2.5 text-[13px] text-muted">
			Replaces <a href={ templ.SafeURL(replaced.rule.href) }>{ replaced.rule.title }</a> <span class="mono text-faint">{ replaced.rule.id }</span>, retired in <a class="mono" href={ templ.SafeURL(replaced.tagHref) }>{ replaced.tag }</a>.
		</div>
	}
	<p class="mb-[14px] text-[13px] text-faint">
		A version describes what work must do to comply with the rule. <b>Major:</b> work that complied with the previous version could fail this one. <b>Minor:</b> it still complies, and this version adds guidance. <b>Patch:</b> it still complies, and nothing is added. <a href="https://code-rules.fabricahq.com/reference/rule-versions/#choose-a-version-change">How versions work</a>
	</p>
	if r.compareHref != "" {
		<div class="mb-3 flex items-center justify-between gap-4">
			<span class="text-[13px] text-faint">{ plural(len(r.versions), "version", "versions") }</span>
			@smallButton(r.compareHref) {
				Compare versions
			}
		</div>
	}
	@versionList(r)
}

// versionList lists every version of a rule, newest first, each leading to its library release and comparing it with
// the version before.
templ versionList(r ruleView) {
	@rowList() {
		for _, v := range r.versions {
			@rowItem() {
				<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 px-[18px] py-[14px] max-narrow:grid-cols-1 max-narrow:gap-2.5">
					<div class="min-w-0">
						<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
							<b class="mono">{ v.version }</b>
							if v.latest {
								@chip() {
									Latest
								}
							}
							if v.major {
								@majorMark()
							}
							<a class="font-mono text-[13px] text-faint decoration-border-strong underline-offset-3 hover:text-muted" href={ templ.SafeURL(v.releaseHref) } title={ "What " + v.tag + " published" }>{ v.tag }</a>
							<span class="text-[13px] text-faint">{ v.date }</span>
						</div>
						<div class="mt-1">
							for _, summary := range v.summaries {
								<div class="text-[13px] text-muted">{ summary }</div>
							}
						</div>
					</div>
					<div class="flex flex-wrap items-center justify-end gap-[14px] max-narrow:justify-start">
						if v.compareHref != "" {
							@smallButton(v.compareHref) {
								Compare with { v.previous }
							}
						}
						<a class="inline-flex items-center gap-[5px] text-[12px] whitespace-nowrap text-faint no-underline hover:text-muted hover:underline" href={ templ.SafeURL(v.notesURL) } title={ "GitHub Release page for " + v.tag }>
							@githubMark("size-3")
							Release notes
						</a>
					</div>
				</div>
			}
		}
	}
}

// majorMark flags a major change: work that complied with the previous version could fail the new one.
templ majorMark() {
	<span class="rounded-[4px] border border-border-strong px-1.5 text-[11px] leading-[18px] font-semibold tracking-[.02em] whitespace-nowrap text-muted" title="Work that complied with the previous version could fail this one.">Major</span>
}

// messagePage is a page that only says what happened, such as for a missing page or a failure.
templ messagePage(c chrome, title, message string) {
	@layout(c, head{title: title + " · Rulemart"}) {
		<div class="page wrap">
			<h1 class="title-xl">{ title }</h1>
			<p class="mt-2.5 text-muted">{ message } <a href="/">Go home</a>.</p>
		</div>
	}
}
