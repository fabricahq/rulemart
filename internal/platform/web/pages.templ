// The pages: home, the libraries, a library, a rule, and the pages for a missing page or a failure. browse.templ,
// groups.templ, and search.templ hold the pages across libraries.

package web

import "strconv"

// homePage is the prototype's: the hero with its search and the popular groups, each kind's groups as tiles, the
// first libraries, and the band that invites a library's owner to list it.
templ homePage(c chrome, v homeView) {
	@layout(c, head{title: "Rulemart: Code Rules libraries", description: "Find and adopt Code Rules libraries: the engineering rules coding agents follow while they write and review your code."}) {
		<section class="wrap pt-20 pb-12 text-center max-narrow:pt-14 max-narrow:pb-9">
			@label("") {
				Fabrica / Rulemart
			}
			<h1 class="mt-[22px] mb-[18px] text-[clamp(2.25rem,4.6vw,3.6rem)] leading-[1.08] font-normal tracking-[-.06em]">
				Agent coding best practices,{ " " }
				<br class="max-narrow:hidden"/>
				off the shelf
			</h1>
			<p class="mx-auto max-w-[50rem] text-[18px] text-balance text-muted">No need to reinvent the wheel. Pick proven rules from other teams and add them straight to your codebase.</p>
			@bigSearch("home-search")
			if len(v.popular) > 0 {
				<div class="mt-[14px] flex flex-wrap items-center justify-center gap-2 text-[13px] text-faint">
					Popular
					for _, g := range v.popular {
						@chipLink(g.href) {
							{ g.label.name }
						}
					}
				</div>
			}
		</section>
		if !v.empty() {
			<section class="border-t border-border-subtle py-11">
				<div class="wrap">
					@bandHeading("Technologies", techsKind.href(), "Browse all →", "")
					@groupTiles(v.techs)
					@bandHeading("Practices", practicesKind.href(), "Browse all →", "mt-[34px]")
					@groupTiles(v.practices)
				</div>
			</section>
		}
		<section class="border-t border-border-subtle py-11">
			<div class="wrap">
				@bandHeading("Libraries", librariesHref, "All libraries →", "")
				if len(v.libraries) == 0 {
					<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">No libraries yet.</div>
				} else {
					@rowList() {
						for _, lib := range v.libraries {
							@rowItem() {
								@libraryRow(lib, true)
							}
						}
					}
				}
			</div>
		</section>
		<section class="border-t border-border-subtle py-11">
			<div class="wrap">
				<div class="flex flex-wrap items-center justify-between gap-5 rounded-panel border border-border bg-surface p-7">
					<div>
						@label("mb-1.5") {
							Stock the shelves
						}
						<h3 class="text-[1.35rem] tracking-[-.035em]">Have a public Code Rules library?</h3>
						<p class="mt-1.5 text-muted">List it on Rulemart in a minute. Rulemart updates with every library release.</p>
					</div>
					<a class="inline-flex min-h-10 items-center justify-center gap-2 rounded-full border border-primary bg-primary px-[18px] py-2 text-[14px] font-medium whitespace-nowrap text-on-primary no-underline transition-opacity hover:opacity-85" href={ templ.SafeURL(v.listHref) }>List your library →</a>
				</div>
			</div>
		</section>
	}
}

// bandHeading heads a band of the home page: its name, and a link to all of what it shows.
templ bandHeading(name, href, linkText, class string) {
	<div class={ "mb-[18px] flex items-baseline justify-between gap-4 max-narrow:flex-wrap", class }>
		<h2 class="text-[1.6rem] font-medium tracking-[-.045em] max-narrow:text-[1.35rem]">{ name }</h2>
		<a class="whitespace-nowrap" href={ templ.SafeURL(href) }>{ linkText }</a>
	</div>
}

// groupTiles shows one kind's canonical groups as the prototype's grid of tiles, four across, two on a phone, and
// one on a narrow phone, where two would cut off names such as Concurrency, each leading to its page.
templ groupTiles(groups []groupSummaryView) {
	<div class="grid grid-cols-4 gap-3 max-narrow:grid-cols-2 max-tiny:grid-cols-1">
		for _, g := range groups {
			<a class="flex min-w-0 items-center gap-3 rounded-card border border-border bg-paper px-[18px] py-4 text-ink no-underline transition-colors duration-[160ms] hover:border-border-strong hover:bg-surface" href={ templ.SafeURL(g.href) }>
				@groupTile(g.label, g.icon, tileMD)
				<span class="grid min-w-0">
					<span class="text-[15px] font-semibold">{ g.label.name }</span>
					<span class="mt-0.5 text-[12.5px] text-muted">{ plural(g.rules, "rule", "rules") } · { plural(len(g.libraries), "library", "libraries") }</span>
				</span>
			</a>
		}
	</div>
}

// libraryRow is a library's row in a list of libraries, the prototype's libLine: its owner's avatar, its name, its
// description, and its repository with its rule count, leading to its page, with its stars when it's vetted and has
// any. The library's name is a heading of level 2, or 3 when headed is true, under a heading of the page's own. A
// link to an unvetted library's page carries nofollow.
templ libraryRow(lib libraryCard, headed bool) {
	@rowLink(lib.href, lib.unvetted) {
		<div class="flex min-w-0 items-start gap-[14px]">
			@avatar(lib.avatar, lib.owner, avatarMD)
			<div class="min-w-0">
				if headed {
					<h3 class="leading-[1.35] font-semibold">{ lib.name }</h3>
				} else {
					<h2 class="leading-[1.35] font-semibold">{ lib.name }</h2>
				}
				if lib.description != "" {
					<p class="mt-0.5 text-[13px] text-muted">{ lib.description }</p>
				}
				<div class="mt-1 text-[12.5px] text-faint">
					<span class="mono">
						@breakable(lib.owner + "/" + lib.name)
					</span>
					· { plural(lib.rules, "rule", "rules") }
				</div>
			</div>
		</div>
		<span class="text-[12.5px] whitespace-nowrap text-muted">
			if lib.stars > 0 && !lib.unvetted {
				@starCount(lib.stars, lib.starredByYou)
			}
		</span>
	}
}


// librariesPage lists every vetted library, under a lede that says anyone can list a public library, leading to
// listing one when canList is true, and where the unvetted ones are.
templ librariesPage(c chrome, libraries []libraryCard, canList bool) {
	@layout(c, head{title: "Libraries · Rulemart", description: "Every vetted Code Rules library: the engineering rules coding agents follow while they write and review your code.", section: librariesHref}) {
		<div class="page wrap">
			@label("") {
				Libraries
			}
			<h1 class="title-xl mt-2 mb-2">Libraries Rulemart has vetted</h1>
			<p class="mb-[22px] max-w-[46rem] text-muted">
				if canList {
					Anyone can <a href={ templ.SafeURL(listHref) }>list a public library</a>.
				} else {
					Anyone can list a public library.
				}
				It shows, with a warning, under <a href={ templ.SafeURL(unvettedHref) } rel="nofollow">unvetted libraries</a> until Rulemart reviews and vets it. Check the owner line to see who stands behind each one.
			</p>
			if len(libraries) == 0 {
				<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">No libraries yet.</div>
			} else {
				@rowList() {
					for _, lib := range libraries {
						@rowItem() {
							@libraryRow(lib, false)
						}
					}
				}
			}
		</div>
	}
}

// libraryTab names a tab of a library's page.
type libraryTab string

const (
	groupsTab   libraryTab = "groups"
	rulesTab    libraryTab = "rules"
	releasesTab libraryTab = "releases"
)

// libraryPage shows a library's groups, or with rulesTab its rules by group, beside its facts.
templ libraryPage(c chrome, lib libraryView, contents libraryContents, current libraryTab) {
	@libraryFrame(c, head{title: lib.owner + "/" + lib.name + " · Rulemart", description: lib.summary(), section: librariesHref}, lib, current, true) {
		if current == rulesTab {
			@allRules(contents)
		} else {
			@groupList("Technologies", lib, contents.techs)
			@groupList("Practices", lib, contents.practices)
		}
	}
}

// libraryFrame is every page about a library: its name, its stars when it's vetted, its tabs with current on, and the
// tab's content, beside the library's facts when withFacts, under the warning when the library isn't vetted.
templ libraryFrame(c chrome, h head, lib libraryView, current libraryTab, withFacts bool) {
	@layout(c, libraryHead(h, lib)) {
		<div class="page wrap">
			if !lib.vetted {
				@unvettedWarning(false)
			}
			<div class="grid grid-cols-[56px_minmax(0,1fr)_auto] items-start gap-[18px] max-narrow:grid-cols-[56px_minmax(0,1fr)]">
				@avatar(lib.avatar, lib.owner, avatarLG)
				<div>
					<h1 class="title-xl"><span class="text-faint">{ lib.owner } /</span> <span class="inline-block">{ lib.name }</span></h1>
					if lib.description != "" {
						<p class="mt-1.5 mb-2.5 text-muted">{ lib.description }</p>
					}
				</div>
				<div class="flex flex-wrap items-center gap-2.5 max-narrow:col-span-full">
					if lib.cart.shown {
						@cartButton(lib.cart)
					}
					if lib.star.shown {
						@starControl(lib.star)
					}
					@smallButton(lib.githubURL) {
						@githubMark("size-[15px] flex-none")
						View on GitHub
					}
				</div>
			</div>
			@tabs([]tab{
				{name: "Groups", href: lib.href, count: lib.groups, on: current == groupsTab},
				{name: "All rules", href: lib.href + "?tab=rules", count: lib.rules, on: current == rulesTab},
				{name: "Library releases", href: releasesHref(lib), count: lib.releases, on: current == releasesTab},
			})
			if withFacts {
				<div class="grid grid-cols-[minmax(0,1fr)_300px] gap-9 max-wide:grid-cols-1">
					<div class="min-w-0">
						{ children... }
					</div>
					<aside class="grid content-start gap-[18px]">
						@libraryFacts(lib)
					</aside>
				</div>
			} else {
				{ children... }
			}
		</div>
	}
}

// groupList lists one kind of group, each leading to its rules on the All rules tab, and a canonical group also to
// its page across libraries. The row's main link covers the row, and the second link sits above it.
templ groupList(kind string, lib libraryView, groups []groupView) {
	if len(groups) > 0 {
		@labelHeading("mt-[22px] mb-2 first:mt-0") {
			{ kind } · { strconv.Itoa(len(groups)) }
		}
		@rowList() {
			for _, g := range groups {
				@rowItem() {
					<div class={ "relative grid items-center gap-[14px] px-4 py-3 transition-colors duration-[120ms] hover:bg-surface has-[.row-link:focus-visible]:outline-3 has-[.row-link:focus-visible]:outline-offset-[-3px] has-[.row-link:focus-visible]:outline-(--focus) max-narrow:grid-cols-[minmax(0,1fr)_auto]", templ.KV("grid-cols-[minmax(190px,260px)_minmax(0,1fr)_auto]", !g.cart.shown), templ.KV("grid-cols-[minmax(190px,260px)_minmax(0,1fr)_auto_auto]", g.cart.shown) }>
						<div class="flex min-w-0 items-center gap-3">
							@groupTile(g.label, g.icon, tileMD)
							<div class="min-w-0">
								<a class="row-link block text-[14px] leading-[22px] font-semibold text-ink no-underline after:absolute after:inset-0 focus-visible:outline-none" href={ templ.SafeURL(lib.href + "?tab=rules#" + g.anchor) }>
									if g.label.canonical {
										{ g.label.name }
									} else {
										{ g.label.id }
									}
								</a>
								if g.label.canonical {
									<span class="block font-mono text-[12px] leading-[20px] text-faint">{ g.label.id }</span>
								} else {
									<span class="block leading-[20px]">
										@notCanonical(flagMD)
									</span>
								}
							</div>
						</div>
						<div class="text-[13px] text-muted max-narrow:col-span-full max-narrow:row-start-2 max-narrow:pl-10 max-narrow:empty:hidden">
							if g.blurb != "" {
								<p>{ g.blurb }</p>
							}
							if g.acrossHref != "" {
								<a class="relative z-10 mt-0.5 inline-block text-[12.5px] text-muted no-underline underline-offset-3 hover:text-ink hover:underline" href={ templ.SafeURL(g.acrossHref) }>{ g.label.name } rules in every library ›</a>
							}
						</div>
						<span class="text-[12.5px] whitespace-nowrap text-muted max-narrow:col-start-2 max-narrow:row-start-1">{ plural(len(g.rules), "rule", "rules") } ›</span>
						if g.cart.shown {
							// As wide as In cart, so every row's count lines up whichever its control reads.
							<div class="relative z-10 flex justify-end narrow:min-w-[5.25rem] max-narrow:col-span-full max-narrow:row-start-3 max-narrow:justify-start max-narrow:pl-10">
								@cartButton(g.cart)
							</div>
						}
					</div>
				}
			}
		}
	}
}

// allRules lists every current rule under its group.
templ allRules(contents libraryContents) {
	for _, g := range contents.all() {
		<div class="mt-8 mb-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-border px-0.5 pb-[7px] first:mt-0">
			<h2 class="flex scroll-mt-20 items-center gap-2 text-[11px] tracking-[.1em] text-faint uppercase" id={ g.anchor }>
				@groupTile(g.label, g.icon, tileXS)
				if g.label.canonical {
					<span>{ g.label.name } <span class="mono tracking-normal normal-case">{ g.label.id }</span></span>
				} else {
					<span class="mono tracking-normal normal-case">{ g.label.id }</span>
					@notCanonical(flagSM)
				}
			</h2>
			if g.cart.shown {
				@cartButton(g.cart)
			}
		</div>
		@ruleCards() {
			for _, r := range g.rules {
				@ruleCardLink(r)
			}
		}
	}
	if len(contents.retired) > 0 {
		<h2 class="mt-8 mb-3 border-b border-border px-0.5 pb-[7px] text-[11px] tracking-[.1em] text-faint uppercase" id="retired">Retired</h2>
		@rowList() {
			for _, r := range contents.retired {
				@rowItem() {
					@retiredRuleRow(r)
				}
			}
		}
	}
}

// retiredRuleRow is a retired rule in the All rules tab, leading to its page.
templ retiredRuleRow(r retiredRuleCard) {
	<a class="group grid grid-cols-[minmax(0,1fr)_14px] items-center gap-[18px] px-[18px] py-3 text-ink no-underline transition-colors duration-[120ms] hover:bg-surface focus-visible:outline-offset-[-3px]" href={ templ.SafeURL(r.href) }>
		<div class="min-w-0">
			<div class="text-[14px] leading-[1.35] font-semibold">{ r.title }</div>
			<div class="mt-0.5 text-[12.5px] text-muted">
				<span class="mono text-faint">
					@breakable(r.id)
				</span> · last version <span class="mono">{ r.lastVersion }</span> · retired in <span class="mono">{ r.retiredTag }</span>
				if len(r.replacedBy) > 0 {
					·
					for _, step := range rowChainSteps(r.replacedBy, r.renamed) {
						{ step.prefix }<span class="mono">
							@breakable(step.id)
						</span>
					}
				}
			</div>
		</div>
		<span class="text-[12.5px] text-muted" aria-hidden="true">›</span>
	</a>
}

// ruleTab names a tab of a rule's page.
type ruleTab string

const (
	contentTab  ruleTab = "rule"
	versionsTab ruleTab = "versions"
)

// rulePage shows a rule's current version, or with versionsTab every version, newest first. A retired rule's page
// shows how it was retired and its versions instead.
templ rulePage(c chrome, r ruleView, current ruleTab) {
	@ruleFrame(c, head{title: r.title + " · " + r.library.owner + "/" + r.library.name + " · Rulemart", description: r.summary(), section: librariesHref}, r, current) {
		if r.retired != nil {
			@retiredRule(r)
		} else if current == versionsTab {
			@versions(r)
		} else {
			@ruleContent(r)
		}
	}
}

// ruleFrame is every page about a rule: where it is in its library, its title, its tabs with current on while it's
// current, and the tab's content, under the warning when the library isn't vetted.
templ ruleFrame(c chrome, h head, r ruleView, current ruleTab) {
	@layout(c, libraryHead(h, r.library)) {
		<div class="page wrap">
			if !r.library.vetted {
				@unvettedWarning(false)
			}
			<div class="mb-[14px] flex flex-wrap items-center gap-1.5 text-[13px] text-faint">
				@avatar(r.library.avatar, r.library.owner, avatarSM)
				<a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(r.library.href) }>{ r.library.name }</a>
				<span>›</span>
				if r.group.canonical {
					<a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(r.groupHref) }>{ r.group.name }</a>
					<span class="mono">{ r.group.id }</span>
				} else {
					<a class="mono text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(r.groupHref) }>{ r.group.id }</a>
					@notCanonical(flagSM)
				}
				if r.acrossHref != "" {
					<a class="ml-auto text-muted no-underline hover:text-ink hover:underline max-narrow:ml-0 max-narrow:basis-full" href={ templ.SafeURL(r.acrossHref) }>{ r.group.name } rules in every library ›</a>
				}
			</div>
			<div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
				<div>
					<h1 class="title-xl max-w-[44rem]">{ r.title }</h1>
					<div class="mt-2.5 flex flex-wrap items-center gap-x-[14px] gap-y-1.5 text-[13px] text-muted">
						if r.retired != nil {
							<span class="rounded-full border border-border-strong px-2.5 text-[12px] font-medium text-ink">Retired</span>
							<span>Last version <span class="mono">{ r.version }</span></span>
						} else {
							@impact(r.impact)
							<span class="mono" title="Latest version">{ r.version }</span>
						}
					</div>
				</div>
				if r.cart.shown {
					@cartButton(r.cart)
				}
			</div>
			if r.retired == nil {
				@tabs([]tab{
					{name: "Rule", href: r.href, count: -1, on: current == contentTab},
					{name: "Versions", href: r.href + "?tab=versions", count: len(r.versions), on: current == versionsTab},
				})
			} else {
				<div class="mt-[26px]"></div>
			}
			{ children... }
		</div>
	}
}


// retiredRule says when and why a library release retired a rule, and what replaced it, then shows its last
// version's text and lists its versions.
templ retiredRule(r ruleView) {
	<div class="mb-7 rounded-[10px] border border-l-[3px] border-border border-l-border-strong bg-surface px-[18px] py-[14px] text-[14px]">
		<p><b class="font-semibold">Retired in</b> <a class={ releaseTagClass } href={ templ.SafeURL(r.retired.href) }>{ r.retired.tag }</a> <span class="text-faint">· { r.retired.date }</span></p>
		for _, summary := range r.retired.summaries {
			<p class="mt-1 text-muted">{ summary }</p>
		}
		if len(r.retired.replacedBy) > 0 {
			<p class="mt-1.5">
				@replacementChain(r.retired.replacedBy, r.retired.renamed)
			</p>
		}
		<p class="mt-1.5 text-[13px] text-faint">Projects that pin it keep its last version. Other projects drop it when they update.</p>
	</div>
	if r.html != "" {
		<section aria-labelledby="last-text">
			<div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
				@labelHeading("") {
					<span id="last-text">Text of version <span class="mono tracking-normal normal-case">{ r.version }</span></span>
				}
				@githubLink(r.fileURL, "View on GitHub", r.fileName+" at "+r.version+" on GitHub")
			</div>
			<div class="prose mb-9 max-w-[52rem]">
				@templ.Raw(r.html)
			</div>
		</section>
	}
	@labelHeading("mb-2") {
		Versions · { strconv.Itoa(len(r.versions)) }
	}
	@versionList(r)
}

// replacesNotes say which retired rules the rule replaced, or renamed.
templ replacesNotes(r ruleView) {
	if r.renamedFrom != nil {
		<div class="mb-[14px] rounded-[10px] border border-dashed border-border-strong px-[14px] py-2.5 text-[13px] text-muted">
			Renamed from <a href={ templ.SafeURL(r.renamedFrom.rule.href) }>{ r.renamedFrom.rule.id }</a> in <a class={ releaseTagClass } href={ templ.SafeURL(r.renamedFrom.tagHref) }>{ r.renamedFrom.tag }</a>.
		</div>
	}
	for _, replaced := range r.replaces {
		<div class="mb-[14px] rounded-[10px] border border-dashed border-border-strong px-[14px] py-2.5 text-[13px] text-muted">
			Replaces <a href={ templ.SafeURL(replaced.rule.href) }>{ replaced.rule.title }</a> <span class="mono text-faint">{ replaced.rule.id }</span>, retired in <a class={ releaseTagClass } href={ templ.SafeURL(replaced.tagHref) }>{ replaced.tag }</a>.
		</div>
	}
}

templ ruleContent(r ruleView) {
	@replacesNotes(r)
	<div class="grid grid-cols-[minmax(0,1fr)_280px] gap-9 max-wide:grid-cols-1">
		<div class="prose">
			<div class="when-to-apply mb-5 border-l-2 border-border-strong py-0.5 pl-[14px] text-[14px] text-muted">
				<b class="mb-0.5 block text-[11px] font-semibold tracking-[.1em] text-ink uppercase">When to apply</b>
				if r.whenToReadHTML != "" {
					@templ.Raw(r.whenToReadHTML)
				} else {
					{ r.whenToRead }
				}
			</div>
			@templ.Raw(r.html)
		</div>
		<aside class="grid content-start gap-[18px]">
			@aboutPanel(impactNote(r.impact)) {
				@fact("Library") {
					<a class="inline-flex items-start gap-1.5 text-right" href={ templ.SafeURL(r.library.href) }>
						<span class="mt-0.5 inline-flex">
							@avatar(r.library.avatar, r.library.owner, avatarXS)
						</span>
						<span class="min-w-0 underline underline-offset-4">
							@breakable(r.library.owner + "/" + r.library.name)
						</span>
					</a>
				}
				@fact("Repository") {
					@factLink(r.library.githubURL, r.library.name, "github.com/"+r.library.owner+"/"+r.library.name)
				}
				@fact("License") {
					@license(r.library)
				}
				@fact("File") {
					@factLink(r.fileURL, r.fileName, r.id+".md")
				}
				@fact("Updated") {
					{ r.updated }
				}
				@fact("Impact") {
					@impact(r.impact)
				}
			}
		</aside>
	</div>
}

// versions lists every version of a rule, newest first, with what it replaced and a way to compare its versions.
templ versions(r ruleView) {
	@replacesNotes(r)
	<h2 class="sr-only">Versions</h2>
	<p class="mb-[14px] text-[13px] text-faint">
		A version describes what work must do to comply with the rule. <b>Major:</b> work that complied with the previous version could fail this one. <b>Minor:</b> it still complies, and this version adds guidance. <b>Patch:</b> it still complies, and nothing is added. <a href={ templ.SafeURL(versionsDocs) }>How versions work</a>
	</p>
	if r.compareHref != "" {
		<div class="mb-3 flex items-center justify-between gap-4">
			<span class="text-[13px] text-faint">{ plural(len(r.versions), "version", "versions") }</span>
			@smallButton(r.compareHref) {
				Compare versions
			}
		</div>
	}
	@versionList(r)
}

// versionList lists every version of a rule, newest first, each under its own heading, leading to its library
// release and comparing it with the version before.
templ versionList(r ruleView) {
	@rowList() {
		for _, v := range r.versions {
			@rowItem() {
				<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 px-[18px] py-[14px] max-narrow:grid-cols-1 max-narrow:gap-2.5">
					<div class="min-w-0">
						<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
							<h3 class="mono font-semibold">{ v.version }</h3>
							if v.latest {
								@latestBadge()
							}
							if v.major {
								@majorMark()
							}
							@releaseTagLink(v.releaseHref, v.tag)
							<span class="text-[13px] text-faint">{ v.date }</span>
						</div>
						<div class="mt-1">
							for _, summary := range v.summaries {
								<div class="text-[13px] text-muted">{ summary }</div>
							}
						</div>
					</div>
					// Each row's button is as wide as the widest a version usually needs, so their edges line up.
					<div class="grid grid-cols-[auto_auto] items-center gap-[14px] max-narrow:flex max-narrow:flex-wrap">
						<span class="max-narrow:empty:hidden narrow:min-w-[10.5rem] narrow:[&>a]:w-full">
							if v.compareHref != "" {
								@smallButton(v.compareHref) {
									Compare with { v.previous }
								}
							}
						</span>
						@releaseNotesLink(v.notesURL, v.tag)
					</div>
				</div>
			}
		}
	}
}

// releaseTagLink leads to a library release, named by its tag, on the Library releases tab.
templ releaseTagLink(href, tag string) {
	<a class={ releaseTagClass } href={ templ.SafeURL(href) }>{ tag }</a>
}

// latestBadge marks a rule's latest version, or a library's latest release.
templ latestBadge() {
	<span class="inline-flex items-center rounded-full border border-border px-2 text-[11.5px] leading-[18px] font-medium whitespace-nowrap text-muted">Latest</span>
}

// majorMark flags a major change, and leads to what one means: work that complied with the previous version could
// fail the new one. It says so to assistive technology too, so no one needs to hover to learn it.
templ majorMark() {
	<a class="inline-flex items-center rounded-full border border-border-strong px-2 text-[11.5px] leading-[18px] font-medium whitespace-nowrap text-ink no-underline hover:bg-surface" href={ templ.SafeURL(versionsDocs) } title={ majorExplanation } aria-label={ majorExplanation + " How versions work." }>Major</a>
}

// messagePage is a page that only says what happened, such as for a missing page or a failure.
templ messagePage(c chrome, title, message string) {
	@layout(c, head{title: title + " · Rulemart"}) {
		<div class="page wrap">
			<h1 class="title-xl">{ title }</h1>
			<p class="mt-2.5 text-muted">{ message } <a href="/">Go home</a>.</p>
		</div>
	}
}
