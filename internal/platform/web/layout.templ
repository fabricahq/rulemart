// The frame every page shares: the document head, the header with Rulemart's name, its links, and search, and the
// footer.

package web

import (
	"cmp"
	"strconv"

	"github.com/fabricahq/rulemart/internal/contexts/catalog/domain"
)

// chrome is what the frame links: the stylesheet, the theme and menu scripts, the icons, the font to preload, and the
// page's canonical address.
type chrome struct {
	stylesheet, script, menuScript, icon, font string
	// touchIcon is the icon a phone's home screen shows.
	touchIcon string
	// caretScript puts the caret at the end of a field the page focuses, and copyScript shows Copy buttons and copies,
	// on a page that asks for each.
	caretScript, copyScript string
	// canonical is the page's absolute address on Options.BaseURL, or empty when there's no base URL or the page,
	// such as a missing one, has no address of its own.
	canonical string
	// socialImage is the absolute address of the image a link to the page shows on social sites and in chat, set
	// with canonical.
	socialImage string
	// beacon is the data Cloudflare's analytics beacon reads, naming the site's token, or empty when analytics are
	// off.
	beacon string
}

// head is a page's title and description, and how its frame differs from other pages'.
type head struct {
	title, description string
	// noindex asks search engines not to index the page.
	noindex bool
	// unvetted marks a page about a library that isn't vetted, which asks search engines neither to index it nor to
	// follow its links, and names no canonical address, so listing a repository can't borrow Rulemart's reputation.
	unvetted bool
	// section is the header's link to the part of the site the page belongs to, librariesHref or groupsHref, or empty.
	section string
	// searchPage leaves the header's search field out, keeping its space, since the page holds its own.
	searchPage bool
	// narrow lays a notice out as wide as narrowPage, for a page of that width.
	narrow bool
	// notice is the page's own notice, which takes the place of the notice cookie's, or empty, and noticeAction what
	// the notice offers to do, such as add an item to the cart after signing in, or nil.
	notice       string
	noticeAction templ.Component
	// caret loads the script that puts the caret at the end of a field the page focuses, and copy the one that shows
	// Copy buttons.
	caret, copy bool
}

// narrowPage is the width of a page about the visitor's own account: signing in aside, its pages and listing.
const narrowPage = "max-w-[44rem]"

// libraryHead returns h for a page about lib: an unvetted page when lib isn't vetted, with the notice its star control
// gives, if any.
func libraryHead(h head, lib libraryView) head {
	h.unvetted = !lib.vetted
	h.notice = cmp.Or(lib.star.notice, lib.cartNotice)
	if lib.cartOffer != nil && h.notice == lib.cartNotice {
		h.noticeAction = cartOffer(*lib.cartOffer)
	}
	return h
}

// layout renders a page's document around its main content.
templ layout(c chrome, h head) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ h.title }</title>
			if description := summary(h.description); description != "" {
				<meta name="description" content={ description }/>
			}
			if h.unvetted {
				<meta name="robots" content="noindex, nofollow"/>
			} else if h.noindex {
				<meta name="robots" content="noindex"/>
			}
			if c.canonical != "" && !h.unvetted {
				<link rel="canonical" href={ c.canonical }/>
			}
			if c.canonical != "" && !h.unvetted && !h.noindex {
				@socialCard(c, h)
			}
			<link rel="icon" type="image/svg+xml" href={ c.icon }/>
			<link rel="apple-touch-icon" href={ c.touchIcon }/>
			<link rel="preload" href={ c.font } as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ c.stylesheet }/>
			<script src={ c.script }></script>
			<script src={ c.menuScript } defer></script>
			if h.caret {
				<script src={ c.caretScript } defer></script>
			}
			if h.copy {
				<script src={ c.copyScript } defer></script>
			}
		</head>
		<body class="flex min-h-screen flex-col">
			<a class="sr-only z-50 rounded-full bg-primary px-4 py-2 text-[14px] font-medium text-on-primary no-underline focus:not-sr-only focus:fixed focus:top-3 focus:left-4 focus:px-4 focus:py-2" href="#main">Skip to content</a>
			@header(h)
			if notice := cmp.Or(h.notice, visitorOf(ctx).notice); notice != "" {
				<div class="border-b border-border-subtle bg-surface" role="status">
					<div class={ "wrap flex flex-wrap items-center gap-x-4 gap-y-2 py-2.5 text-[14px] text-ink", templ.KV(narrowPage, h.narrow) }>
						<p>{ notice }</p>
						if h.noticeAction != nil {
							@h.noticeAction
						}
					</div>
				</div>
			}
			<main id="main" class="flex-1" tabindex="-1">
				{ children... }
			</main>
			@footer()
			if c.beacon != "" {
				// Cloudflare's snippet goes before the body's end; it sets no cookie.
				<script defer src={ analyticsScript } data-cf-beacon={ c.beacon }></script>
			}
		</body>
	</html>
}

// socialCard is what a link to the page shows on social sites and in chat, by Open Graph's tags, which X reads too:
// its title, description, address, and Rulemart's image. Only a page with an address of its own, which search engines
// may index, has one, so a link to an unvetted library's page shows none of Rulemart's.
templ socialCard(c chrome, h head) {
	<meta property="og:type" content="website"/>
	<meta property="og:site_name" content="Rulemart"/>
	<meta property="og:title" content={ h.title }/>
	if description := summary(h.description); description != "" {
		<meta property="og:description" content={ description }/>
	}
	<meta property="og:url" content={ c.canonical }/>
	<meta property="og:image" content={ c.socialImage }/>
	<meta property="og:image:width" content="1200"/>
	<meta property="og:image:height" content="630"/>
	<meta property="og:image:alt" content="Rulemart: agent coding best practices, off the shelf"/>
	<meta name="twitter:card" content="summary_large_image"/>
}

// header is the bar atop every page: Rulemart's name, links to the libraries and the groups, a search field, which a phone's
// narrow header replaces with a link to the search page, and the visitor's account menu or a link to sign in.
templ header(h head) {
	<header class="sticky top-0 z-30 border-b border-border bg-paper">
		<div class="wrap flex h-[60px] items-center gap-[22px] max-narrow:gap-3 max-tiny:gap-2">
			<div class="inline-flex items-baseline gap-2 text-[1.05rem] font-[650] tracking-[-.04em] whitespace-nowrap max-narrow:items-center max-narrow:gap-1.5">
				// A phone's header has room for Fabrica's mark but not its name, which stays for screen readers, and a
				// narrow phone's has room for Rulemart's name alone.
				<a class="relative inline-block pl-[21px] text-[.85em] font-normal tracking-[-.02em] text-faint no-underline hover:text-ink max-narrow:grid max-narrow:h-11 max-narrow:place-items-center max-narrow:pl-0 max-tiny:hidden" href="https://fabricahq.com">
					@fabricaMark("absolute top-1/2 left-0 size-[15px] -translate-y-1/2 max-narrow:static max-narrow:translate-y-0")
					<span class="max-narrow:sr-only">Fabrica</span>
				</a>
				<span class="font-normal text-muted max-tiny:hidden">/</span>
				<a class="text-ink no-underline" href="/" aria-label="Rulemart home">Rulemart</a>
			</div>
			<nav class="ml-auto flex items-center gap-[18px] max-narrow:gap-1 max-tiny:gap-0" aria-label="Rulemart">
				@navLink(librariesHref, "Libraries", h.section)
				@navLink(groupsHref, "Groups", h.section)
				if h.searchPage {
					// The page holds its own search field; the space keeps the links where every other page has them.
					<div class="w-[15rem] max-narrow:hidden" aria-hidden="true"></div>
				} else {
					<form class="relative max-narrow:hidden" action={ templ.SafeURL(searchHref) } method="get" role="search">
						<label class="sr-only" for="header-search">Search rules</label>
						@searchIcon("pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-faint")
						<input id="header-search" class="h-9 w-[15rem] rounded-full border border-border bg-paper pr-3 pl-9 text-[14px] text-ink placeholder:text-faint hover:border-border-strong focus-visible:border-(--focus) focus-visible:shadow-[0_0_0_1px_var(--focus)] focus-visible:outline-none" type="search" name="q" placeholder="Search rules" maxlength={ strconv.Itoa(domain.MaxSearchQueryLength) } autocomplete="off"/>
					</form>
				}
				<a class="grid size-11 place-items-center rounded-full text-muted no-underline hover:bg-surface hover:text-ink narrow:hidden" href={ templ.SafeURL(searchHref) } aria-label="Search rules" title="Search rules">
					@searchIcon("size-5")
				</a>
				@accountControl(visitorOf(ctx))
			</nav>
		</div>
	</header>
}

// navLink is a header link to a part of the site, marked current on every page of section, since each belongs to
// the part it links.
templ navLink(href, name, section string) {
	<a
		class={ "inline-flex min-h-11 items-center text-[14px] no-underline hover:text-ink max-narrow:px-1.5 max-tiny:px-1", templ.KV("font-medium text-ink", section == href), templ.KV("text-muted", section != href) }
		href={ templ.SafeURL(href) }
		if section == href {
			aria-current="true"
		}
	>{ name }</a>
}

// footer is the bar at the bottom of every page: what Rulemart and Code Rules are, Rulemart's privacy notice, its
// source, where to report a problem, and the theme menu.
templ footer() {
	<footer class="border-t border-border pt-[22px] pb-10 text-[13px] text-muted">
		<div class="wrap flex flex-wrap items-center gap-x-6">
			<span>Fabrica / Rulemart</span>
			// A phone's footer keeps the theme menu beside Rulemart's name, and its links on lines of their own below.
			<nav class="ml-auto flex flex-wrap items-center gap-x-[18px] max-narrow:order-last max-narrow:ml-0 max-narrow:w-full max-narrow:gap-x-4" aria-label="About Rulemart">
				@footerLink(aboutHref, "About Rulemart")
				@footerLink(privacyHref, "Privacy")
				@footerLink(codeRulesURL, "About Code Rules")
				@footerLink(repositoryURL, "Source on GitHub")
				@footerLink(reportProblemURL, "Report a problem")
			</nav>
			<div class="max-narrow:ml-auto">
				@themeMenu()
			</div>
		</div>
	</footer>
}

// footerLink is one of the footer's links, tall enough to tap.
templ footerLink(href, text string) {
	<a class="inline-flex min-h-11 items-center text-muted no-underline hover:text-ink hover:underline hover:underline-offset-3" href={ templ.SafeURL(href) }>{ text }</a>
}

// themeChoice is one of the color themes a visitor can choose.
type themeChoice struct {
	value, name string
	icon        templ.Component
}

var themeChoices = []themeChoice{
	{value: "light", name: "Light", icon: sunIcon()},
	{value: "dark", name: "Dark", icon: moonIcon()},
	{value: "system", name: "System", icon: monitorIcon()},
}

// themeMenu is the Fabrica website's color theme menu: a round button showing the current choice's icon, and a
// menu of the three choices with a check on the current one. Its focus rings are the website's, thinner than the
// rest of Rulemart's. It opens upward, since it sits at the bottom of the
// page. theme.js shows it and keeps it in step with the visitor's choice, and menus.js closes it; without JavaScript
// the page follows the system theme and shows no menu.
templ themeMenu() {
	<details id="theme-control" class="relative shrink-0" data-menu hidden>
		<summary
			class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full text-muted transition-colors hover:bg-surface hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink [&::-webkit-details-marker]:hidden"
			aria-label="Color theme: System"
			title="Color theme: System"
		>
			for _, choice := range themeChoices {
				<span data-theme-icon={ choice.value } hidden?={ choice.value != "system" }>
					@choice.icon
				</span>
			}
		</summary>
		<div class="absolute right-0 bottom-[calc(100%+8px)] z-40 grid w-44 gap-1 rounded-xl border border-border bg-paper p-1.5 shadow-lg" role="group" aria-label="Color theme">
			for _, choice := range themeChoices {
				<button
					type="button"
					data-theme-choice={ choice.value }
					aria-pressed="false"
					class="flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-lg border border-transparent px-3 text-left text-sm text-muted transition-colors hover:bg-surface hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-ink aria-pressed:border-border-strong aria-pressed:bg-paper aria-pressed:font-medium aria-pressed:text-ink aria-pressed:hover:bg-paper [&[aria-pressed=true]_.theme-check]:opacity-100"
				>
					@choice.icon
					<span>{ choice.name }</span>
					<svg class="theme-check ml-auto size-3.5 shrink-0 opacity-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m3 8 3 3 7-7"></path>
					</svg>
				</button>
			}
		</div>
	</details>
}

// searchIcon is a magnifying glass, in the current text color.
templ searchIcon(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="11" cy="11" r="7"></circle>
		<path d="m20 20-3.5-3.5"></path>
	</svg>
}

templ sunIcon() {
	<svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path>
	</svg>
}

templ moonIcon() {
	<svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"></path>
	</svg>
}

templ monitorIcon() {
	<svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="3" y="4" width="18" height="13" rx="2"></rect>
		<path d="M8 21h8m-4-4v4"></path>
	</svg>
}

// fabricaMark is Fabrica's logo, a cube, drawn in the current text color.
templ fabricaMark(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 1.75 21.25 7.1V17L12 22.35 2.75 17V7.1Z"></path>
			<path d="m2.75 7.1 9.25 5.35 9.25-5.35M12 12.45v9.9"></path>
			<path d="m7.375 4.425 9.25 5.35M7.375 9.775v9.9M12 17.4l9.25-5.35"></path>
		</g>
	</svg>
}

// githubMark is GitHub's logo, in the current text color.
templ githubMark(class string) {
	<svg class={ class } viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
		<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
	</svg>
}
