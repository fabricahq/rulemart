// The frame every page shares: the document head, the header with Rulemart's name, and the footer.

package web

// chrome is what the frame links: the stylesheet, the theme script, the icon, and the font to preload.
type chrome struct {
	stylesheet, script, icon, font string
}

// head is a page's title and description.
type head struct {
	title, description string
}

// layout renders a page's document around its main content.
templ layout(c chrome, h head) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ h.title }</title>
			if h.description != "" {
				<meta name="description" content={ h.description }/>
			}
			<link rel="icon" type="image/svg+xml" href={ c.icon }/>
			<link rel="preload" href={ c.font } as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ c.stylesheet }/>
			<script src={ c.script }></script>
		</head>
		<body class="flex min-h-screen flex-col">
			@header()
			<main class="flex-1">
				{ children... }
			</main>
			@footer()
		</body>
	</html>
}

templ header() {
	<header class="sticky top-0 z-30 border-b border-border bg-paper/92 backdrop-blur-[10px]">
		<div class="wrap flex h-[60px] items-center gap-[22px]">
			<div class="inline-flex items-baseline gap-2 text-[1.05rem] font-[650] tracking-[-.04em] whitespace-nowrap">
				<a class="relative inline-block pl-[21px] text-[.85em] font-normal tracking-[-.02em] text-faint no-underline hover:text-ink" href="https://fabricahq.com">
					@fabricaMark("absolute top-1/2 left-0 size-[15px] -translate-y-1/2")
					Fabrica
				</a>
				<span class="font-normal text-muted">/</span>
				<a class="text-ink no-underline" href="/" aria-label="Rulemart home">Rulemart</a>
			</div>
		</div>
	</header>
}

templ footer() {
	<footer class="border-t border-border pt-[22px] pb-10 text-[13px] text-muted">
		<div class="wrap flex flex-wrap items-center justify-between gap-4">
			<span>Fabrica / Rulemart</span>
			<div class="flex flex-wrap items-center gap-[18px]">
				<a class="text-muted no-underline hover:text-ink hover:underline hover:underline-offset-3" href="https://code-rules.fabricahq.com">About Code Rules</a>
				@themeMenu()
			</div>
		</div>
	</footer>
}

// themeChoice is one of the color themes a visitor can choose.
type themeChoice struct {
	value, name string
	icon        templ.Component
}

var themeChoices = []themeChoice{
	{value: "light", name: "Light", icon: sunIcon()},
	{value: "dark", name: "Dark", icon: moonIcon()},
	{value: "system", name: "System", icon: monitorIcon()},
}

// themeMenu is the Fabrica website's color theme menu: a round button showing the current choice's icon, and a
// menu of the three choices with a check on the current one. Its focus rings are the website's, thinner than the
// rest of Rulemart's. It opens upward, since it sits at the bottom of the
// page. theme.js shows it, keeps it in step with the visitor's choice, and closes it; without JavaScript the page
// follows the system theme and shows no menu.
templ themeMenu() {
	<details id="theme-control" class="relative shrink-0" hidden>
		<summary
			class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full text-muted transition-colors hover:bg-surface hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink [&::-webkit-details-marker]:hidden"
			aria-label="Color theme: System"
			title="Color theme: System"
		>
			for _, choice := range themeChoices {
				<span data-theme-icon={ choice.value } hidden?={ choice.value != "system" }>
					@choice.icon
				</span>
			}
		</summary>
		<div class="absolute right-0 bottom-[calc(100%+8px)] z-40 grid w-44 gap-1 rounded-xl border border-border bg-paper p-1.5 shadow-lg" role="group" aria-label="Color theme">
			for _, choice := range themeChoices {
				<button
					type="button"
					data-theme-choice={ choice.value }
					aria-pressed="false"
					class="flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-lg border border-transparent px-3 text-left text-sm text-muted transition-colors hover:bg-surface hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-ink aria-pressed:border-border-strong aria-pressed:bg-paper aria-pressed:font-medium aria-pressed:text-ink aria-pressed:hover:bg-paper [&[aria-pressed=true]_.theme-check]:opacity-100"
				>
					@choice.icon
					<span>{ choice.name }</span>
					<svg class="theme-check ml-auto size-3.5 shrink-0 opacity-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m3 8 3 3 7-7"></path>
					</svg>
				</button>
			}
		</div>
	</details>
}

templ sunIcon() {
	<svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"></path>
	</svg>
}

templ moonIcon() {
	<svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"></path>
	</svg>
}

templ monitorIcon() {
	<svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="3" y="4" width="18" height="13" rx="2"></rect>
		<path d="M8 21h8m-4-4v4"></path>
	</svg>
}

// fabricaMark is Fabrica's logo, a cube, drawn in the current text color.
templ fabricaMark(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 1.75 21.25 7.1V17L12 22.35 2.75 17V7.1Z"></path>
			<path d="m2.75 7.1 9.25 5.35 9.25-5.35M12 12.45v9.9"></path>
			<path d="m7.375 4.425 9.25 5.35M7.375 9.775v9.9M12 17.4l9.25-5.35"></path>
		</g>
	</svg>
}

// githubMark is GitHub's logo, in the current text color.
templ githubMark(class string) {
	<svg class={ class } viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
		<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
	</svg>
}
