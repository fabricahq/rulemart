// The pages of listing: the warning every unvetted page shows, the unvetted libraries, and the page that confirms
// removing a listing.

package web

import "github.com/fabricahq/rulemart/internal/contexts/catalog/domain"

// unvettedWarning says a library hasn't been vetted, in the decided words, and why that matters: rules are
// instructions a coding agent follows. With plural, it says so of every library on the page.
templ unvettedWarning(plural bool) {
	<div class="mb-7 flex gap-3 rounded-card border border-warn-border bg-warn-surface px-4 py-3.5 max-narrow:px-3.5" role="note">
		@warningIcon("mt-[3px] size-[18px] shrink-0 text-warn-ink")
		<div class="min-w-0">
			if plural {
				<p class="text-[15px] leading-[1.5] font-semibold text-warn-ink">These libraries have not been vetted. Be sure to review their rules carefully.</p>
				<p class="mt-1 text-[14px] text-ink">A library's maintainers can list it on Rulemart, and Rulemart hasn't reviewed these. Their rules are instructions your coding agent follows.</p>
			} else {
				<p class="text-[15px] leading-[1.5] font-semibold text-warn-ink">{ unvettedWarningText }</p>
				<p class="mt-1 text-[14px] text-ink">A library's maintainers can list it on Rulemart, and Rulemart hasn't reviewed this one. Its rules are instructions your coding agent follows.</p>
			}
		</div>
	</div>
}

// warningIcon is a triangle with an exclamation mark, in the current text color.
templ warningIcon(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M10.3 3.9 1.8 18.5A2 2 0 0 0 3.5 21.5h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path>
		<path d="M12 9.5v4.5M12 17.5h.01"></path>
	</svg>
}

// unvettedPage lists the libraries listings name that aren't vetted, under the warning, and leads to listing one when
// canList is true. Like every unvetted page, it asks search engines neither to index it nor to follow its links.
templ unvettedPage(c chrome, libraries []libraryCard, canList bool) {
	@layout(c, head{title: "Unvetted libraries · Rulemart", unvetted: true}) {
		<div class="page wrap">
			<div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
				<h1 class="title-xl">Unvetted libraries</h1>
				if canList {
					<a class={ pageActionStyle } href={ templ.SafeURL(listHref) }>List a library</a>
				}
			</div>
			<p class="mt-1.5 mb-[22px] max-w-[46rem] text-muted">Libraries people listed that Rulemart hasn't vetted. Search and browsing leave them out unless you include unvetted libraries.</p>
			if len(libraries) == 0 {
				<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">No unvetted libraries yet.</div>
			} else {
				@unvettedWarning(true)
				@rowList() {
					for _, lib := range libraries {
						@rowItem() {
							@libraryRow(lib, false)
						}
					}
				}
			}
			<p class="mt-6 text-[14px]"><a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(librariesHref) }>‹ Vetted libraries</a></p>
		</div>
	}
}

// pageActionStyle is a page's action beside its heading, outlined, as tall as a touch target.
const pageActionStyle = "inline-flex min-h-11 shrink-0 items-center justify-center rounded-full border border-border-strong px-4 text-[14px] font-medium whitespace-nowrap text-ink no-underline transition-colors duration-[160ms] hover:border-ink hover:bg-surface"

// inputStyle is a text field, as the prototype's .input, outlined in the color of deletion while its value is invalid.
const inputStyle = "h-11 w-full min-w-0 rounded-[10px] border border-border-strong bg-paper px-3 text-[14px] text-ink placeholder:text-faint hover:border-ink focus-visible:border-(--focus) focus-visible:shadow-[0_0_0_1px_var(--focus)] focus-visible:outline-none aria-invalid:border-del-ink aria-invalid:focus-visible:shadow-[0_0_0_1px_var(--del-ink)]"

// removeListingPage asks the visitor to confirm removing their listing l, and says what removing it does, which
// depends on its state: a listed library leaves Rulemart, a vetted one stays, and one never listed is only forgotten.
templ removeListingPage(c chrome, l listingView) {
	@layout(c, head{title: "Remove a listing · Rulemart", noindex: true, narrow: true}) {
		<div class={ "page wrap", narrowPage }>
			<p class={ labelStyle }><a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(dashboardHref) }>My libraries</a></p>
			<h1 class="title-xl mt-2.5">Remove this listing?</h1>
			<div class="mt-5 rounded-card border border-border px-5 py-5">
				<div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
					<p class="leading-[1.35] font-semibold [overflow-wrap:anywhere]">{ l.fullName }</p>
					@listingState(l.state)
				</div>
				<p class="mt-3 text-[14.5px] text-ink">
					switch l.state {
						case domain.ListingListed:
							Its library leaves Rulemart: its pages stop showing, and links to them stop working. You can list it again later.
						case domain.ListingVetted:
							Rulemart has vetted its library, so the library stays on Rulemart. Only your listing goes.
						case domain.ListingFailed:
							Rulemart forgets it, and it stops taking one of your places.
						default:
							Rulemart stops checking it, so its library won't show on Rulemart, and it stops taking one of your places.
					}
				</p>
				<div class="mt-5 flex flex-wrap items-center gap-3">
					<form method="post" action={ templ.SafeURL(l.remove) }>
						<button class={ dangerButtonStyle + " min-h-11" } type="submit">Remove listing</button>
					</form>
					<a class={ pageActionStyle } href={ templ.SafeURL(dashboardHref) }>Keep it</a>
				</div>
			</div>
		</div>
	}
}

// listingMessagePage says what happened to a request about a listing, and leads back to My libraries, which lists the
// visitor's listings.
templ listingMessagePage(c chrome, title, message string) {
	@layout(c, head{title: title + " · Rulemart", noindex: true, narrow: true}) {
		<div class={ "page wrap", narrowPage }>
			<h1 class="title-xl">{ title }</h1>
			<p class="mt-2.5 text-muted">{ message } <a href={ templ.SafeURL(dashboardHref) }>My libraries</a>.</p>
		</div>
	}
}

// smallActionStyle is a small outlined button, as smallButton is a link, as tall as a touch target.
const smallActionStyle = "inline-flex min-h-9 cursor-pointer items-center justify-center rounded-full border border-border-strong px-[13px] text-[13px] font-medium whitespace-nowrap text-ink transition-colors duration-[160ms] hover:border-ink hover:bg-surface"

// listingState names a listing's state as a badge.
templ listingState(state domain.ListingState) {
	switch state {
		case domain.ListingVetted:
			<span class="inline-flex items-center rounded-full border border-border-strong px-2 text-[11.5px] leading-[18px] font-medium text-ink">Vetted</span>
		case domain.ListingListed:
			<span class="inline-flex items-center rounded-full border border-warn-border bg-warn-surface px-2 text-[11.5px] leading-[18px] font-medium text-warn-ink">Listed, unvetted</span>
		case domain.ListingFailed:
			<span class="inline-flex items-center rounded-full border border-del-ink px-2 text-[11.5px] leading-[18px] font-medium text-del-ink">Failed</span>
		default:
			<span class="inline-flex items-center rounded-full border border-border px-2 text-[11.5px] leading-[18px] font-medium text-muted">Checking</span>
	}
}
