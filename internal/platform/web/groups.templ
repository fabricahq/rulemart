// A group's page: its rules across libraries, one ranked list beside the filter sidebar.

package web

// groupPage shows a group's rules in every library that holds it, a canonical group's or any other's, in one ranked
// list beside the filters, as the prototype's group page does. A group that isn't canonical says it only includes the
// libraries that chose its exact ID. A page with any choice in its address asks search engines not to index it, and
// still names the group's own address as canonical.
templ groupPage(c chrome, g groupPageView) {
	@layout(c, head{title: g.title(), description: g.summary(), noindex: !g.indexed(), filters: true}) {
		<div class="page wrap">
			<div class="mb-[14px] flex flex-wrap items-center gap-1.5 text-[13px] text-faint">
				<a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(g.kind.href()) }>{ g.kind.name() }</a>
				if !g.label.canonical {
					<span>›</span>
					<a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(g.kind.othersHref()) }>Other groups</a>
				}
				<span>›</span>
				<span class="mono">{ g.label.id }</span>
			</div>
			<h1 class="title-xl flex flex-wrap items-center gap-x-[14px] gap-y-2">
				if g.label.canonical {
					@groupTile(g.label, g.icon, tileTitle)
					{ g.label.name }
				} else {
					<span class="[overflow-wrap:anywhere]">{ g.label.id }</span>
					<span class="inline-flex items-center rounded-full border border-border px-[11px] py-0.5 text-[12.5px] font-normal tracking-normal whitespace-nowrap text-muted" title={ notCanonicalExplanation }>Not canonical</span>
				}
			</h1>
			if !g.label.canonical {
				<p class="mt-[14px] rounded-[10px] border border-dashed border-border-strong px-[14px] py-2.5 text-[13px] text-muted"><span class="mono">{ g.label.id }</span> isn't a canonical group, so it only includes rules from libraries that chose this exact name.</p>
			}
			// A group no library holds says so below, rather than counting none here. The count is of current rules, even
			// while the list shows retired ones.
			<p class="mt-2 mb-6 text-muted">
				if g.list.current > 0 {
					{ plural(g.list.current, "rule", "rules") } from { plural(len(g.list.libraryFilters), "library", "libraries") }
					if g.description != "" {
						{ " · " }
					}
				}
				{ g.description }
			</p>
			@listLayout() {
				@filterSidebar(g.list)
				<section aria-labelledby="results">
					<h2 id="results" class="sr-only">Rules</h2>
					@resultsHead(g.list, "")
					if g.list.filteredOut() {
						@noFilteredRules(g.list)
					} else if g.list.onlyRetired() {
						<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">
							Every rule in this group is retired.{ " " }
							<a class={ chipStyle } href={ templ.SafeURL(g.list.retiredHref()) }>Show retired rules</a>
						</div>
					} else if len(g.rows) == 0 {
						<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">No library has { g.label.display() } rules yet.</div>
					} else {
						@ruleRows() {
							for _, r := range g.rows {
								@ruleRow(r)
							}
						}
						if g.truncated() {
							<p class="mt-4 text-[13px] text-muted">This page shows the first { plural(len(g.rows), "rule", "rules") }. Filter the list to see the rest.</p>
						}
					}
				</section>
			}
		</div>
	}
}
