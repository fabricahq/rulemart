// The parts and page of stars: a rule's star control, its stars wherever a page shows them, and a signed-in visitor's
// Starred rules.

package web

import "strconv"

// starControl is a rule's star in its page's head: a toggle button that stars it, or once starred unstars it, for a
// signed-in visitor; a link that signs anyone else in and returns them, on a page that's the same for everyone; or the
// count alone when no one can sign in. Screen readers hear its state, what it does, and the count in words; the
// button's name starts with its visible label, Star or Starred, so a visitor who speaks that label reaches it. The page
// that follows starring, unstarring, or signing in to star focuses it, with pageFocus's quiet ring.
templ starControl(star starView) {
	if star.action != "" {
		<form method="post" action={ templ.SafeURL(star.action) }>
			<button
				id="star"
				class={ starButtonStyle, "cursor-pointer", templ.KV(starredStyle, star.starred && !star.prompt), templ.KV(unstarredStyle, !star.starred && !star.prompt), templ.KV(promptStyle, star.prompt) }
				type="submit"
				aria-pressed={ strconv.FormatBool(star.starred) }
				title={ starTitle(star.starred) }
				{ pageFocus(star.focused)... }
				if star.prompt {
					data-prompt
				}
			>
				<span class="sr-only">{ starLabel(star.starred) }, { starCountText(star.count) }: { star.title }</span>
				@starFace(star.count, star.starred, starLabel(star.starred))
			</button>
		</form>
	} else if star.signIn != "" {
		<a class={ starButtonStyle, unstarredStyle, "no-underline" } href={ templ.SafeURL(star.signIn) } title={ "Sign in to star this rule. " + starExplanation } data-star-signin>
			<span class="sr-only">Sign in to star { star.title }, { starCountText(star.count) }</span>
			@starFace(star.count, false, "Star")
		</a>
		@starSignInDialog(star)
	} else {
		@starCount(star.count, false, "text-[13px] text-muted")
	}
}

// starSignInDialog is the prototype's "Sign in to star rules" dialog, which star.js opens in place of following the
// star's sign-in link. Continue follows that link, so the page after signing in asks to star the rule, and the close
// and Not now buttons close it through their forms' dialog method, with no script.
templ starSignInDialog(star starView) {
	<dialog class={ dialogStyle } aria-labelledby="star-sign-in-title" data-star-dialog>
		<div class="mb-[14px] flex items-start justify-between gap-3">
			<h2 class="text-[1.35rem] tracking-[-.035em]" id="star-sign-in-title">Sign in to star rules</h2>
			<form method="dialog">
				<button class={ dialogCloseStyle } aria-label="Close">×</button>
			</form>
		</div>
		<p class="text-muted">Star this rule if you find it useful.</p>
		<div class="mt-4 flex flex-wrap gap-2.5">
			<a class={ cartPrimaryStyle } href={ templ.SafeURL(star.signIn) }>
				if star.withGitHub {
					@githubMark("size-[15px]")
					Continue with GitHub
				} else {
					Sign in
				}
			</a>
			<form method="dialog">
				<button class={ outlineButtonStyle }>Not now</button>
			</form>
		</div>
	</dialog>
}

// starLabel is what the star button reads: Starred once starred, and Star otherwise.
func starLabel(starred bool) string {
	if starred {
		return "Starred"
	}
	return "Star"
}

// starTitle is the star button's hover text: what clicking it does, and what a star is for.
func starTitle(starred bool) string {
	if starred {
		return "Unstar this rule. " + starExplanation
	}
	return "Star this rule. " + starExplanation
}

// The star button's styles, the prototype's small ghost button: its shape, then unstarred, a quiet outline; starred,
// outlined in ink on the surface color, as the prototype's on state; and prompting after signing in to star, outlined
// in ink inside a ring. Each changes on hover enough to show in either theme.
const (
	starButtonStyle = "inline-flex min-h-8 items-center rounded-full border px-[13px] py-1 text-[13px] font-medium whitespace-nowrap transition-colors duration-[160ms]"
	unstarredStyle  = "border-border text-muted hover:border-ink hover:bg-surface hover:text-ink"
	starredStyle    = "border-ink bg-surface text-ink hover:bg-surface-header"
	promptStyle     = "border-ink text-ink ring-2 ring-ink ring-offset-2 ring-offset-paper hover:bg-surface"
)

// A rule's stars look and read alike wherever a page shows them: starFace and starCount share the star, starIcon,
// the count's formatting, formatCount, such as 1,234, and its words, starCountText.

// starFace is the face of a rule's star button or sign-in link: a star, filled once starred, then label, then the
// count unless it's 0, in the faint color at the label's weight, as the prototype draws it. Screen readers skip it,
// since the control names itself to them.
templ starFace(count int, starred bool, label string) {
	<span class="inline-flex items-center gap-2" aria-hidden="true">
		@starIcon("size-[15px] flex-none", starred)
		<span>{ label }</span>
		if count > 0 {
			<span class="text-faint tabular-nums">{ formatCount(count) }</span>
		}
	</span>
}

// starCount is a rule's stars without a control, in a row or on a page where no one can star the rule: a star, filled
// when filled is true, and the count, which screen readers hear in words. It shows nothing at 0, so a row stays quiet
// until its rule has stars. class places it.
templ starCount(count int, filled bool, class string) {
	if count > 0 {
		<span class={ "inline-flex items-center gap-1 leading-none whitespace-nowrap tabular-nums", class } title={ starCountText(count) }>
			@starIcon("size-3 flex-none", filled)
			<span aria-hidden="true">{ formatCount(count) }</span>
			<span class="sr-only">{ starCountText(count) }</span>
		</span>
	}
}

// starIcon is a five-pointed star in the current text color, filled when filled is true.
templ starIcon(class string, filled bool) {
	<svg class={ class } viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true">
		if filled {
			<path fill="currentColor" d="M8 1.6l1.98 4.01 4.42.64-3.2 3.12.76 4.4L8 11.69l-3.96 2.08.76-4.4-3.2-3.12 4.42-.64Z"></path>
		} else {
			<path fill="none" d="M8 1.6l1.98 4.01 4.42.64-3.2 3.12.76 4.4L8 11.69l-3.96 2.08.76-4.4-3.2-3.12 4.42-.64Z"></path>
		}
	</svg>
}
