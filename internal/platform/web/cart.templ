// The cart's parts: the header's link to the cart, the controls that add to it from rule and group pages, the dialogs
// that ask what to add and confirm adding from an unvetted library, and the cart's page. cart.js keeps the cart in the
// visitor's browser and paints these from the data attributes they carry; without JavaScript, the stylesheet hides
// every part marked data-needs-script, since the cart can't work.

package web

import (
	"strconv"

	"github.com/fabricahq/rulemart/internal/contexts/catalog/domain"
)

// cartKey returns the key the browser's cart keeps the group or rule at path of lib by.
func cartKey(lib libraryView, kind domain.CartItemKind, path string) string {
	return domain.CartItem{Owner: lib.owner, Name: lib.name, Kind: kind, Path: path}.Key()
}

// The cart's controls, as the prototype draws them: a filled button, the green In cart pill, and a quiet text button.
const (
	cartPrimaryStyle = "inline-flex min-h-10 cursor-pointer items-center justify-center gap-2 rounded-full border border-primary bg-primary px-[18px] py-2 text-[14px] font-medium whitespace-nowrap text-on-primary no-underline transition-opacity duration-[160ms] hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-45"
	inCartStyle      = "inline-flex items-center gap-1 rounded-full bg-ok-surface px-3 py-[5px] text-[13.5px] leading-[1.65] font-semibold whitespace-nowrap text-ok"
	cartLinkButton   = "cursor-pointer text-[13px] text-muted underline underline-offset-4 hover:text-ink"
)

// cartLink is the header's link to the cart, for everyone: a cart, with the count of items the visitor's cart holds,
// which cart.js paints, in a badge and in its name, such as Cart, 2 items. Marked current on the cart's page. It tells
// cart.js how many items a cart holds, and how long a key may be, as checkout bounds them.
templ cartLink(current bool) {
	<a
		class={ "relative grid size-9 shrink-0 place-items-center rounded-full text-ink no-underline hover:bg-surface max-wide:size-11", templ.KV("bg-surface", current) }
		href={ templ.SafeURL(cartHref) }
		aria-label="Cart"
		data-cart-link
		data-cart-max-items={ strconv.Itoa(domain.MaxCartItems) }
		data-cart-max-key-length={ strconv.Itoa(domain.MaxCartKeyLength) }
		if current {
			aria-current="page"
		}
	>
		@cartIcon("size-5")
		<span class="absolute top-px right-0 grid h-[17px] min-w-[17px] place-items-center rounded-full bg-primary px-1 text-[10.5px] leading-none font-semibold text-on-primary max-wide:top-[5px] max-wide:right-1" data-cart-count hidden></span>
	</a>
}

// ruleCartControl is the rule page head's cart control: Add to cart, which opens addToCartDialog, or once the cart
// holds the rule, or its whole group, the In cart pill, Checkout, and a way to remove it. cart.js shows the state
// the cart is in.
templ ruleCartControl(r ruleView) {
	@cartNeedsScript("max-w-[16rem] text-right max-narrow:text-left")
	<div
		class="flex flex-col items-end gap-2 max-narrow:items-start"
		data-needs-script
		data-cart-control
		data-cart-library={ r.library.fullName() }
		data-cart-vetted={ strconv.FormatBool(r.library.vetted) }
		data-cart-rule={ cartKey(r.library, domain.CartRule, r.id) }
		data-cart-group={ cartKey(r.library, domain.CartGroup, r.group.id) }
		data-cart-group-name={ r.group.display() }
	>
		<button class={ cartPrimaryStyle } type="button" data-cart-open>
			@cartIcon("size-[15px] flex-none")
			Add to cart
		</button>
		@heldControls(heldAtEnd)
	</div>
	@addToCartDialog(r)
}

// groupCartControl is a library group page's cart control: Add <Group> group to cart, which adds the group whole, or
// once the cart holds it, the In cart pill, Checkout, and a way to remove it. cart.js shows the state the cart is in.
templ groupCartControl(lib libraryView, g groupView) {
	<div
		class="flex flex-col gap-2"
		data-needs-script
		data-cart-control
		data-cart-library={ lib.fullName() }
		data-cart-vetted={ strconv.FormatBool(lib.vetted) }
		data-cart-group={ cartKey(lib, domain.CartGroup, g.label.id) }
		data-cart-group-name={ g.label.display() }
	>
		<button class={ cartPrimaryStyle, "w-full" } type="button" data-cart-add-group>
			@cartIcon("size-[15px] flex-none")
			Add { g.label.display() } group to cart
		</button>
		@heldControls(heldAcross)
	</div>
	@cartNeedsScript("")
}

// cartNeedsScript says, where scripts don't run, why a page offers no way to add to the cart, as the cart's page
// does: the cart lives in the browser.
templ cartNeedsScript(class string) {
	<noscript>
		<p class={ "text-[13px] text-muted", class }>Your cart lives in your browser, so adding to it needs JavaScript.</p>
	</noscript>
}

// heldAlign is how heldControls sit: heldAtEnd at the end of a page's head, or heldAcross across a box.
type heldAlign int

const (
	heldAtEnd heldAlign = iota
	heldAcross
)

// heldControls are what a cart control shows once the cart holds its item: the In cart pill, which names a group
// the cart holds whole when it covers the item, Checkout, and Remove, which cart.js names and shows.
templ heldControls(align heldAlign) {
	<div class={ "flex flex-col", templ.KV("items-end gap-2 max-narrow:items-start", align == heldAtEnd), templ.KV("items-start gap-2.5", align == heldAcross) } data-cart-held hidden>
		<div class={ "flex items-center gap-2.5", templ.KV("flex-wrap", align == heldAtEnd), templ.KV("w-full justify-between", align == heldAcross) }>
			<span class={ inCartStyle }>
				@checkIcon("size-3.5 flex-none")
				<span data-cart-held-text>In cart</span>
			</span>
			<a class={ cartPrimaryStyle } href={ templ.SafeURL(cartHref) }>Checkout</a>
		</div>
		<button class={ cartLinkButton } type="button" data-cart-remove>Remove from cart</button>
	</div>
}

// dialogStyle is a dialog of the cart's, the prototype's narrow modal, near the top of the viewport over a scrim.
const dialogStyle = "mx-auto mt-[70px] mb-[30px] w-[min(460px,calc(100%-32px))] max-w-none rounded-panel border border-border bg-paper p-6 text-ink shadow-[0_30px_80px_-30px_rgb(0_0_0/.5)] backdrop:bg-scrim max-narrow:mt-10 max-narrow:p-5"

// dialogHead is a cart dialog's title, with what it asks below it, and its close button.
templ dialogHead(title, ask string) {
	<div class="mb-[14px] flex items-start justify-between gap-3">
		<div>
			<h2 class="text-[1.35rem] tracking-[-.035em]">{ title }</h2>
			if ask != "" {
				<p class="mt-1 text-[13px] text-muted">{ ask }</p>
			}
		</div>
		<button class="cursor-pointer rounded-sm px-1.5 py-0.5 text-[22px] leading-none text-muted hover:bg-surface hover:text-ink" type="button" aria-label="Close" data-cart-close>×</button>
	</div>
}

// choiceStyle is one of a dialog's choices: a card-like button.
const choiceStyle = "mt-2.5 grid w-full cursor-pointer gap-1 rounded-[14px] border border-border bg-paper px-4 py-3.5 text-left transition-colors duration-[120ms] hover:border-ink hover:bg-surface"

// addToCartDialog asks what to add from a rule's page, as the prototype's modal does: just the rule, which stays in
// sync with its library, or its whole group, which brings the library's later rules of it too. For a library Rulemart
// doesn't vet, it first warns, as the library's pages do, and asks the visitor to confirm, which the cart records, and
// says checkout pins its rules to the reviewed commit and doesn't fork them.
templ addToCartDialog(r ruleView) {
	<dialog class={ dialogStyle } aria-label="Add to cart" data-cart-dialog>
		if !r.library.vetted {
			<div data-cart-step="confirm">
				@unvettedConfirmation(r.library.fullName())
			</div>
		}
		<div data-cart-step="choose" hidden?={ !r.library.vetted }>
			@dialogHead("Add to cart", "What would you like to add?")
			<button class={ choiceStyle } type="button" data-cart-pick="rule">
				<b class="flex items-center gap-[7px] text-[15px] font-semibold">Just this rule</b>
				<span class="mt-0.5 block text-[13px] text-muted">
					if r.library.vetted {
						Adds only “{ r.title }.” It stays in sync with { r.library.fullName() }, and nothing else from the group is added.
					} else {
						Adds only “{ r.title }.” It's pinned to the commit you review, and nothing else from the group is added.
					}
				</span>
			</button>
			<button class={ choiceStyle } type="button" data-cart-pick="group">
				// The group's icon and name stay together on a narrow phone, and the words around them wrap.
				<b class="flex flex-wrap items-center gap-x-[7px] text-[15px] font-semibold">
					The whole
					<span class="inline-flex items-center gap-[7px] whitespace-nowrap">
						@groupTile(r.group, r.groupIcon, tileXS)
						{ r.group.display() }
					</span>
					group
				</b>
				<span class="mt-0.5 block text-[13px] text-muted">
					Adds this rule and the { strconv.Itoa(r.groupRules-1) } other { r.group.display() } { pluralWord(r.groupRules-1, "rule", "rules") } from { r.library.fullName() }.{ " " }
					@groupUpdates(r.library)
				</span>
			</button>
			<p class="mt-[14px] text-[12px] text-faint">
				if r.library.vetted {
					At checkout, you'll pick which project these go into, and you can fork a rule instead of staying in sync.
				} else {
					At checkout, you'll pick which project these go into. Forking waits until the rules are vetted, so you get exactly the reviewed text.
				}
			</p>
		</div>
	</dialog>
}

// groupUpdates says what a whole group of lib brings later: the rules the library adds to it, or, for a library
// Rulemart doesn't vet, which checkout pins to the commit reviewed, nothing.
templ groupUpdates(lib libraryView) {
	if lib.vetted {
		New rules the library adds to this group arrive when you update.
	} else {
		It's pinned to the commit you review, so rules the library adds later don't arrive.
	}
}

// unvettedConfirmation warns, inside a dialog, that library isn't vetted, as its pages do, and asks the visitor to
// confirm adding from it anyway, or to cancel.
templ unvettedConfirmation(library string) {
	@dialogHead("Add to cart", "")
	<div class="flex gap-3 rounded-card border border-warn-border bg-warn-surface px-4 py-3.5" role="note">
		@warningIcon("mt-[3px] size-[18px] shrink-0 text-warn-ink")
		<div class="min-w-0">
			<p class="text-[15px] leading-[1.5] font-semibold text-warn-ink">This library has not been vetted. Be sure to review these rules carefully.</p>
			<p class="mt-1 text-[14px] text-ink">Anyone signed in can list a library on Rulemart, and Rulemart hasn't reviewed { library }. At checkout, the prompt asks your agent to review its rules before following them.</p>
		</div>
	</div>
	<div class="mt-[18px] flex flex-wrap gap-2.5">
		<button class={ cartPrimaryStyle } type="button" data-cart-confirm>Add from it anyway</button>
		<button class={ outlineButtonStyle } type="button" data-cart-close>Cancel</button>
	</div>
}

// confirmDialog asks a visitor adding groups from a library Rulemart doesn't vet to confirm it first, on its pages
// that add groups.
templ confirmDialog(lib libraryView) {
	if !lib.vetted {
		<dialog class={ dialogStyle } aria-label="Add to cart" data-cart-dialog>
			<div data-cart-step="confirm">
				@unvettedConfirmation(lib.fullName())
			</div>
		</dialog>
	}
}

// groupsCartPanel is the library page's Add to cart box beside its groups, as the prototype's: it adds the groups the
// visitor ticks, each whole, which cart.js counts and adds, and on a phone, a bar that does the same while any is
// ticked.
templ groupsCartPanel(lib libraryView) {
	<div class="rounded-panel border border-border bg-paper p-[18px]" data-needs-script data-cart-groups data-cart-library={ lib.fullName() } data-cart-vetted={ strconv.FormatBool(lib.vetted) }>
		@label("mb-1.5") {
			Add to cart
		}
		<p class="mb-[14px] text-[13px] text-muted" data-cart-groups-text>Select whole groups to add. You can also add single rules from their pages.</p>
		<button class={ cartPrimaryStyle, "w-full" } type="button" data-cart-groups-add disabled>
			@cartIcon("size-[15px] flex-none")
			<span data-cart-groups-label>Add groups to cart</span>
		</button>
		<div class="mt-2.5 flex flex-wrap gap-2.5">
			<button class="inline-flex cursor-pointer items-center rounded-full border border-border px-[11px] py-0.5 text-[12.5px] whitespace-nowrap text-muted hover:border-border-strong hover:text-ink" type="button" data-cart-groups-all>Select all groups</button>
			<button class="inline-flex cursor-pointer items-center rounded-full border border-border px-[11px] py-0.5 text-[12.5px] whitespace-nowrap text-muted hover:border-border-strong hover:text-ink" type="button" data-cart-groups-clear hidden>Clear</button>
		</div>
		// Below the narrow breakpoint the box sits after every group, far from the checkboxes, so once any is ticked a
		// bar at the viewport's bottom says how many and adds them.
		<div class="fixed inset-x-0 bottom-0 z-20 flex items-center justify-between gap-3 border-t border-border bg-paper px-4 pt-3 pb-[max(12px,env(safe-area-inset-bottom))] shadow-[0_-12px_24px_-20px_rgb(0_0_0/.4)] narrow:hidden" data-cart-groups-bar hidden>
			<span class="text-[14px] font-medium text-ink" data-cart-groups-count></span>
			<button class={ cartPrimaryStyle } type="button" data-cart-groups-add>
				@cartIcon("size-[15px] flex-none")
				Add to cart
			</button>
		</div>
	</div>
	@confirmDialog(lib)
}

// groupPick is a group row's checkbox, which ticks the group for the groupsCartPanel of its library to add. cart.js
// ticks and disables it while the cart holds the group, so the box counts only what it would add.
templ groupPick(lib libraryView, g groupView) {
	<input class="relative z-10 size-4 cursor-pointer accent-(--ink) disabled:cursor-default" type="checkbox" data-needs-script data-cart-pick-group={ cartKey(lib, domain.CartGroup, g.label.id) } data-cart-library={ lib.fullName() } aria-label={ "Select " + g.label.display() }/>
}

// groupHeldBadge is a group row's In cart badge, which cart.js shows once the cart holds the group.
templ groupHeldBadge(lib libraryView, g groupView) {
	<span class="inline-flex items-center gap-1 rounded-full bg-ok-surface px-2 text-[11.5px] leading-[18px] font-semibold whitespace-nowrap text-ok" data-cart-held-badge={ cartKey(lib, domain.CartGroup, g.label.id) } hidden>
		@checkIcon("size-3 flex-none")
		In cart
	</span>
}

// cartIcon is a shopping cart, in the current text color.
templ cartIcon(class string) {
	<svg class={ class } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M3 4h2.2l2.1 10.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.1"></path>
		<circle cx="9.5" cy="19.5" r="1.2"></circle>
		<circle cx="17" cy="19.5" r="1.2"></circle>
	</svg>
}

// checkIcon is a check mark, in the current text color.
templ checkIcon(class string) {
	<svg class={ class } viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="m3 8.5 3 3 7-7"></path>
	</svg>
}

// cartPage is the cart's page, as the prototype's: a shell that cart-page.js fills from the cart the browser keeps,
// which it checks out at checkoutHref, which the shell names. An empty cart shows the empty state; a cart with items,
// the three numbered cards: what you're adding, where it goes, and the finished prompt and commands. Without
// JavaScript, the page says the cart needs it. signIn is where signing in starts, empty when sign-in isn't available; a
// signed-in visitor has no projects Rulemart knows of yet.
templ cartPage(c chrome, signIn string, withGitHub, signedIn bool) {
	@layout(c, head{title: "Cart · Rulemart", description: "The rules you picked on Rulemart, and the prompt and commands that add them to your project.", noindex: true, section: cartHref, cartPage: true}) {
		<noscript>
			@cartEmptyFrame("Your cart needs JavaScript", "Your cart lives in your browser, which keeps the rules you add until you check out. Turn on JavaScript to add rules and check out.")
		</noscript>
		<div data-needs-script data-cart-page data-cart-checkout={ checkoutHref }>
			<div data-cart-empty hidden>
				@cartEmptyFrame("Your cart is empty", "Browse rules and add the ones you want. When you check out, you get one prompt for your agent and the exact commands to run.")
			</div>
			<div class="page wrap" data-cart-full hidden>
				@label("") {
					Cart
				}
				<h1 class="title-xl mt-2 mb-7">Checkout</h1>
				<div class="grid grid-cols-[minmax(0,1fr)_380px] items-start gap-8 max-wide:grid-cols-1">
					<div class="min-w-0">
						<section class={ checkoutCardStyle } aria-labelledby="cart-step-1">
							@checkoutStep("1", "What you're adding", "cart-step-1") {
								<span data-cart-summary></span>
							}
							<div class={ checkoutBodyStyle }>
								<div data-cart-libraries aria-live="polite">
									<p class="text-[14px] text-muted">Loading your cart…</p>
								</div>
								<button class={ cartLinkButton } type="button" data-cart-clear>Clear cart</button>
							</div>
						</section>
						<section class={ checkoutCardStyle, "mt-5" } aria-labelledby="cart-step-2">
							@checkoutStep("2", "Where it goes", "cart-step-2") {
								The project these rules are for
							}
							<div class={ checkoutBodyStyle }>
								@projectSection(signIn, withGitHub, signedIn)
							</div>
						</section>
					</div>
					<aside class={ checkoutCardStyle, "wide:sticky wide:top-[84px] wide:flex wide:max-h-[calc(100vh-110px)] wide:flex-col" } aria-labelledby="cart-step-3">
						@checkoutStep("3", "Finish checkout", "cart-step-3") {
						}
						<div class={ checkoutBodyStyle, "flex min-h-0 flex-1 flex-col" }>
							<p class="mb-3 text-[13px] text-muted">Give your agent the prompt, or run the commands yourself. Both update as you change your cart.</p>
							<div class="mb-2.5 inline-flex gap-0.5 self-start rounded-full border border-border p-0.5 text-[12.5px]" role="group" aria-label="Show">
								<button class={ segmentStyle } type="button" aria-pressed="true" data-cart-tab="prompt">Prompt</button>
								<button class={ segmentStyle } type="button" aria-pressed="false" data-cart-tab="commands">Commands</button>
							</div>
							// The tab's text, which cart-page.js fills: one block, or the commands' steps, each under its heading with
							// its own Copy, each block scrolling on its own.
							<div class="flex min-h-0 flex-auto flex-col gap-3.5 transition-opacity duration-[160ms]" role="region" aria-label="Prompt for your agent" data-cart-preview></div>
							// Says when the preview is out of date: while the checkout is updating, or when updating failed. Present while
							// empty, so screen readers announce what it comes to say.
							<p class="mt-2.5 text-[13px] text-muted empty:mt-0" role="status" data-cart-status></p>
							<button class={ cartPrimaryStyle, "mt-3 w-full" } type="button" data-cart-copy>Copy prompt for agent</button>
							<p class="mt-2.5 text-[12px] text-faint" data-cart-footnote>Rules move to newer versions only when your project runs <code>code-rules project update</code>.</p>
						</div>
					</aside>
				</div>
			</div>
		</div>
	}
}

// cartEmptyFrame is the cart's page when it can't show a checkout: the cart icon, title, why, and the ways to browse.
templ cartEmptyFrame(title, why string) {
	<div class="page wrap max-w-[640px] pt-[72px] text-center">
		@cartIcon("mx-auto size-12 text-faint")
		<h1 class="title-xl mt-4 mb-2">{ title }</h1>
		<p class="text-muted">{ why }</p>
		<div class="mt-5 flex flex-wrap justify-center gap-2.5">
			<a class={ outlineButtonStyle, "no-underline" } href={ templ.SafeURL(techsKind.href()) }>Browse techs</a>
			<a class={ outlineButtonStyle, "no-underline" } href={ templ.SafeURL(practicesKind.href()) }>Browse practices</a>
		</div>
	</div>
}

// The checkout's cards, as the prototype's: a panel with a shaded header bar, and the bar's step number.
const (
	checkoutCardStyle = "overflow-hidden rounded-panel border border-border bg-paper"
	checkoutBodyStyle = "p-5 max-narrow:p-4"
	segmentStyle      = "cursor-pointer rounded-full px-[11px] py-[3px] whitespace-nowrap text-muted aria-pressed:bg-surface-header aria-pressed:text-ink"
)

// checkoutStep is a checkout card's header bar: its number, its title, and what the children say, at the end.
templ checkoutStep(n, title, id string) {
	<div class="flex flex-wrap items-center gap-3 border-b border-border bg-surface-header px-5 py-3.5 max-narrow:px-4">
		<span class="grid size-6 flex-none place-items-center rounded-full bg-ink text-[12.5px] font-semibold text-paper" aria-hidden="true">{ n }</span>
		<h2 id={ id } class="text-[1.05rem] leading-[1.3] font-semibold tracking-[-.02em]">{ title }</h2>
		<span class="ml-auto text-[13px] text-muted max-narrow:-mt-1.5 max-narrow:ml-9 max-narrow:basis-full max-narrow:empty:hidden">
			{ children... }
		</span>
	</div>
}

// projectSection is where the checkout's rules go, as the prototype's: signed out, signing in to pick a project, or
// entering one; signed in, the visitor's projects, which Rulemart doesn't read yet, so it says it found none, what it
// looks for, and to enter one. The repository field names the project in the texts; cart.js keeps it, and cart-page.js
// says which repository it read.
templ projectSection(signIn string, withGitHub, signedIn bool) {
	if signedIn {
		<p class="-mt-0.5 mb-4 border-b border-border-subtle pb-4 text-[13px] text-muted">We didn't find any of your projects using Code Rules: repositories with <code>.code-rules/generated/provenance.json</code>. Enter the project below, and the prompt names it.</p>
		<b class="mb-2.5 block text-[13px] font-semibold">Enter your project</b>
	} else if signIn != "" {
		<div class="flex flex-wrap items-center justify-between gap-4">
			<div>
				<b class="text-[13px] font-semibold">Pick from your projects</b>
				<p class="mt-0.5 text-[13px] text-muted">Sign in to choose a project and see when its rules have updates.</p>
			</div>
			<a class={ signInButtonStyle } href={ templ.SafeURL(signIn) }>
				if withGitHub {
					@githubMark("size-[15px] flex-none")
					Sign in with GitHub
				} else {
					Sign in
				}
			</a>
		</div>
		<div class="my-4 flex items-center gap-3 text-[12px] tracking-[.08em] text-faint uppercase before:flex-1 before:border-t before:border-border-subtle after:flex-1 after:border-t after:border-border-subtle">or</div>
		<b class="mb-2.5 block text-[13px] font-semibold">Enter your project</b>
	}
	<label class="mb-1.5 block text-[13px] text-muted" for="cart-repo">GitHub repository <span class="text-faint">(optional, so the prompt names it)</span></label>
	<input id="cart-repo" class="w-full rounded-[10px] border border-border bg-paper px-3 py-2.5 text-[14px] text-ink placeholder:text-faint focus-visible:border-(--focus) focus-visible:shadow-[0_0_0_1px_var(--focus)] focus-visible:outline-none" type="text" placeholder="https://github.com/owner/repo" autocomplete="off" spellcheck="false" maxlength="500" data-cart-repo aria-describedby="cart-repo-note"/>
	<p id="cart-repo-note" class="mt-1.5 text-[12px] text-faint" data-cart-repo-note hidden></p>
	<p class="mt-3.5 text-[13px] text-muted"><b class="font-semibold text-ink">New to Code Rules?</b> The prompt sets it up for you.</p>
}
