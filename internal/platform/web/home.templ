// The home page and the pieces only it shows: its bands' headings and its tiles of groups.

package web

// homePage is the prototype's: the hero with its search and the popular groups, each kind's groups as tiles, the
// first libraries, and the band that invites a library's owner to list it.
templ homePage(c chrome, v homeView) {
	@layout(c, head{title: "Rulemart: Code Rules libraries", description: "Find and adopt Code Rules libraries: the engineering rules coding agents follow while they write and review your code."}) {
		<section class="wrap pt-20 pb-12 text-center max-narrow:pt-14 max-narrow:pb-9">
			@label("") {
				Fabrica / Rulemart
			}
			<h1 class="mt-[22px] mb-[18px] text-[clamp(2.25rem,4.6vw,3.6rem)] leading-[1.08] font-normal tracking-[-.06em]">
				Agent coding best practices,{ " " }
				<br class="max-narrow:hidden"/>
				off the shelf
			</h1>
			<p class="mx-auto max-w-[50rem] text-[18px] text-balance text-muted">No need to reinvent the wheel. Pick proven rules from other teams and add them straight to your codebase.</p>
			@bigSearch("home-search")
			if len(v.popular) > 0 {
				<div class="mt-[14px] flex flex-wrap items-center justify-center gap-2 text-[13px] text-faint">
					Popular
					for _, g := range v.popular {
						@chipLink(g.href) {
							{ g.label.name }
						}
					}
				</div>
			}
		</section>
		if !v.empty() {
			<section class="border-t border-border-subtle py-11">
				<div class="wrap">
					@bandHeading("Technologies", techsKind.href(), "Browse all →", "")
					@groupTiles(v.techs)
					@bandHeading("Practices", practicesKind.href(), "Browse all →", "mt-[34px]")
					@groupTiles(v.practices)
				</div>
			</section>
		}
		<section class="border-t border-border-subtle py-11">
			<div class="wrap">
				@bandHeading("Libraries", librariesHref, "All libraries →", "")
				if len(v.libraries) == 0 {
					<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">No libraries yet.</div>
				} else {
					@rowList() {
						for _, lib := range v.libraries {
							@rowItem() {
								@libraryRow(lib, true)
							}
						}
					}
				}
			</div>
		</section>
		<section class="border-t border-border-subtle py-11">
			<div class="wrap">
				<div class="flex flex-wrap items-center justify-between gap-5 rounded-panel border border-border bg-surface p-7">
					<div>
						@label("mb-1.5") {
							Stock the shelves
						}
						<h3 class="text-[1.35rem] tracking-[-.035em]">Have a public Code Rules library?</h3>
						<p class="mt-1.5 text-muted">List it on Rulemart in a minute. Rulemart updates with every library release.</p>
					</div>
					<a class="inline-flex min-h-10 items-center justify-center gap-2 rounded-full border border-primary bg-primary px-[18px] py-2 text-[14px] font-medium whitespace-nowrap text-on-primary no-underline transition-opacity hover:opacity-85" href={ templ.SafeURL(v.listHref) }>List your library →</a>
				</div>
			</div>
		</section>
	}
}

// bandHeading heads a band of the home page: its name, and a link to all of what it shows.
templ bandHeading(name, href, linkText, class string) {
	<div class={ "mb-[18px] flex items-baseline justify-between gap-4 max-narrow:flex-wrap", class }>
		<h2 class="text-[1.6rem] font-medium tracking-[-.045em] max-narrow:text-[1.35rem]">{ name }</h2>
		<a class="whitespace-nowrap" href={ templ.SafeURL(href) }>{ linkText }</a>
	</div>
}

// groupTiles shows one kind's canonical groups as the prototype's grid of tiles, four across, two on a phone, and
// one on a narrow phone, where two would cut off names such as Concurrency, each leading to its page.
templ groupTiles(groups []groupSummaryView) {
	<div class="grid grid-cols-4 gap-3 max-narrow:grid-cols-2 max-tiny:grid-cols-1">
		for _, g := range groups {
			<a class="flex min-w-0 items-center gap-3 rounded-card border border-border bg-paper px-[18px] py-4 text-ink no-underline transition-colors duration-[160ms] hover:border-border-strong hover:bg-surface" href={ templ.SafeURL(g.href) }>
				@groupTile(g.label, g.icon, tileMD)
				<span class="grid min-w-0">
					<span class="text-[15px] font-semibold">{ g.label.name }</span>
					<span class="mt-0.5 text-[12.5px] text-muted">{ plural(g.rules, "rule", "rules") } · { plural(len(g.libraries), "library", "libraries") }</span>
				</span>
			</a>
		}
	</div>
}
