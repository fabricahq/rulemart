// The dashboard's page: the visitor's head, and its tabs, My libraries, Projects, Starred rules, and Account.

package web

import (
	"strconv"

	"github.com/fabricahq/rulemart/internal/contexts/catalog/domain"
)

// The dashboard's pieces: a dashed note; the heading of one of a tab's groups, when it has more than one, in sentence
// case with its count; a row of a section's list with something at its far edge; a row of only text, ruled above, so
// the first sits under the lede, and an action on a row's second line, in the page's link style; its title line, and the figure that follows a name on it, 8 pixels after it, or a
// space after it when it opens with a separator; a chip; and a small button.
const (
	noteStyle        = "flex flex-wrap items-center justify-between gap-3 rounded-[10px] border border-dashed border-border-strong px-3.5 py-2.5 text-[13px] text-muted"
	subHeadStyle     = "text-[15px] font-medium tracking-[-.01em] text-ink"
	listRowStyle     = "grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3.5 border-t border-border-subtle py-[13px] first:border-t-0"
	chipOnStyle      = "inline-flex items-center gap-1.5 rounded-full border border-ink bg-surface px-[11px] py-0.5 text-[12.5px] font-normal whitespace-nowrap text-ink no-underline"
	quietChipStyle   = "inline-flex items-center gap-1.5 rounded-full border border-border px-[11px] py-0.5 text-[12.5px] font-normal whitespace-nowrap text-muted no-underline"
	textRowStyle     = "border-t border-border-subtle py-[13px]"
	rowActionStyle   = "cursor-pointer text-[12.5px] text-ink underline decoration-border-strong underline-offset-[3px] hover:decoration-ink"
	titleLineStyle   = "flex flex-wrap items-baseline gap-x-2 gap-y-1 leading-[1.35] font-semibold"
	rowFigureStyle   = "text-[13px] font-normal whitespace-nowrap text-muted tabular-nums"
	linkButtonStyle  = "cursor-pointer text-ink underline underline-offset-[3px] decoration-border-strong hover:decoration-ink"
)

// dashboardPage is the signed-in visitor's dashboard, as the prototype's: under the Dashboard eyebrow, their avatar,
// centered beside their name, login, and organizations, then the tab shown, each with only its own content.
templ dashboardPage(c chrome, d dashboardView) {
	@layout(c, head{title: "Dashboard · Rulemart", noindex: true, deleteAccount: d.tab == accountTab}) {
		<div class="page wrap">
			@label("") {
				Dashboard
			}
			<div class="mt-2.5 flex items-center gap-4">
				@avatar(d.account.avatar, d.account.login, avatarLG)
				<div class="min-w-0">
					<h1 class="title-xl [overflow-wrap:anywhere]">{ nameOrLogin(d.account) }</h1>
					<p class="text-[13px] text-faint [overflow-wrap:anywhere]">
						{ "@" + d.account.login }
						if d.orgs() != "" {
							· member of { d.orgs() }
						}
					</p>
				</div>
			</div>
			@tabs(dashboardTabs(d))
			if lede := dashboardLedes[d.tab]; lede != "" {
				<p class="mb-[22px] max-w-[46rem] text-muted">{ lede }</p>
			}
			switch d.tab {
				case projectsTab:
					@projectsContent(d)
				case starsTab:
					@starredContent(d)
				case accountTab:
					@accountContent(d.account, d.deleteRefused)
				default:
					@librariesContent(d)
			}
		</div>
	}
}

// nameOrLogin is what the dashboard calls the visitor: their GitHub name, or their login.
func nameOrLogin(a accountView) string {
	if a.name != "" {
		return a.name
	}
	return a.login
}

// dashboardLedes say what each of the dashboard's tabs shows, under the tab bar, by the name dashboardTab gives it.
// Account, whose name says it, has none.
var dashboardLedes = map[string]string{
	"":          "The Code Rules libraries you and your organizations publish on Rulemart, and any you listed for others.",
	projectsTab: "Your GitHub projects that use Code Rules libraries from Rulemart, and whether rule updates are waiting for them.",
	starsTab:    "The rules you starred, so you can find them again.",
}

// dashboardTabs are the dashboard's tabs, each but Account with the count of its rows: My libraries; Projects, where
// Rulemart can read visitors' GitHub accounts; Starred rules, where visitors can star; and Account.
func dashboardTabs(d dashboardView) []tab {
	tabs := []tab{{name: "My libraries", href: dashboardHref, count: len(d.mine) + len(d.listedByYou), on: d.tab == ""}}
	if d.gitHub.available {
		tabs = append(tabs, tab{name: "Projects", href: projectsHref, count: len(d.used), on: d.tab == projectsTab})
	}
	if d.starsAvailable {
		tabs = append(tabs, tab{name: "Starred rules", href: starredHref, count: d.starCount, on: d.tab == starsTab})
	}
	return append(tabs, tab{name: "Account", href: dashboardAccountHref, count: -1, on: d.tab == accountTab})
}

// librariesContent is My libraries: the libraries the visitor and their organizations publish, then how to add one,
// then what Rulemart read of GitHub.
templ librariesContent(d dashboardView) {
	<section aria-labelledby="published">
		if len(d.listedByYou) > 0 {
			@groupHeading("published", "Published by you and your orgs", len(d.mine))
		} else {
			<h2 id="published" class="sr-only">Libraries you and your organizations publish</h2>
		}
		if len(d.mine) == 0 {
			<p class="border-t border-border-subtle py-[13px] text-[13.5px] text-muted">No library of yours or your organizations' is on Rulemart yet.</p>
		}
		for _, m := range d.mine {
			@myLibraryRow(m)
		}
		if visitorOf(ctx).listings {
			<div class="mt-3"><a class={ signInButtonStyle } href={ templ.SafeURL(listHref) }>+ Add a library</a></div>
		}
	</section>
	if len(d.listedByYou) > 0 {
		<section class="mt-[30px]" aria-labelledby="listed-by-you">
			@groupHeading("listed-by-you", "Listed by you", len(d.listedByYou))
			for _, m := range d.listedByYou {
				@myLibraryRow(m)
			}
		</section>
	}
	@gitHubSummary(d.gitHub)
}

// groupHeading heads one of a tab's groups, when it has more than one, as id: its name, then its count of rows.
templ groupHeading(id, name string, count int) {
	<h2 id={ id } class={ subHeadStyle, "mb-2" }>{ name }<span class="font-normal text-faint">{ " · " + strconv.Itoa(count) }</span></h2>
}

// myLibraryRow is a row of My libraries: the library's name, leading to its page or to the check that adds it, its
// stars, where Rulemart counts them, New, and its state; then its repository and what its state says of it; and, for a
// listing of the visitor's, Try again when its check failed, and Remove, after what its state says, as small text
// actions.
templ myLibraryRow(m myLibraryView) {
	<div class={ textRowStyle }>
		<div class="min-w-0">
			<p class={ titleLineStyle }>
				<a
					class="no-underline hover:underline [overflow-wrap:anywhere]"
					href={ templ.SafeURL(m.href) }
					if m.nofollow {
						rel="nofollow"
					}
				>{ m.name }</a>
				if m.hasStars {
					<span class={ rowFigureStyle } title={ starCountText(m.stars) }>
						<span aria-hidden="true">★ { formatCount(m.stars) }</span>
						<span class="sr-only">{ starCountText(m.stars) } in all</span>
					</span>
				}
				if m.isNew {
					<span class={ chipOnStyle }>New</span>
				}
				@libraryStateBadge(m.state)
			</p>
			// A div, since a form can't sit inside a paragraph.
			<div class="mt-0.5 text-[12.5px] text-faint [overflow-wrap:anywhere]">
				<span class="mono">@breakable(m.fullName())</span>{ " · " + m.detail }
				if m.retry != "" {
					{ " · " }
					<form class="inline" method="post" action={ templ.SafeURL(m.retry) }>
						<button class={ rowActionStyle } type="submit" aria-label={ "Try adding " + m.fullName() + " again" }>Try again</button>
					</form>
				}
				if m.removeConfirm != "" {
					{ " · " }
					<a class={ rowActionStyle } href={ templ.SafeURL(m.removeConfirm) } aria-label={ "Remove your listing of " + m.fullName() }>Remove</a>
				}
			</div>
		</div>
	</div>
}

// libraryStateBadge names a row of My libraries' state as a chip.
templ libraryStateBadge(state libraryState) {
	switch state {
		case libraryVetted:
			@vettedBadge()
		case libraryUnvetted:
			@unvettedBadge()
		case libraryFailed:
			@listingState(domain.ListingFailed)
		default:
			@listingState(domain.ListingChecking)
	}
}

// projectsContent is Projects: the libraries the visitor's projects use, with the updates waiting for each project,
// then what Rulemart read of GitHub, and where it read the projects' libraries.
templ projectsContent(d dashboardView) {
	<section aria-labelledby="used">
		<h2 id="used" class="sr-only">Libraries your projects use</h2>
		if len(d.used) == 0 {
			<p class="border-t border-border-subtle py-[13px] text-[13.5px] text-muted">
				if d.gitHub.reading {
					Rulemart is reading your projects.
				} else if d.gitHub.readAt == "" {
					Rulemart hasn't read your projects yet.
				} else {
					None of your projects imports a library that's on Rulemart.
				}
			</p>
		}
		for _, u := range d.used {
			<div class={ textRowStyle }>
				<div class="min-w-0">
					<p class={ titleLineStyle }>
						<a class="no-underline hover:underline" href={ templ.SafeURL(u.href) }
							if !u.vetted {
								rel="nofollow"
							}
						>{ u.name }</a>
						<span class={ rowFigureStyle, "-ml-1" }>· { plural(len(u.projects), "project", "projects") }</span>
						if !u.vetted {
							@unvettedBadge()
						}
					</p>
					<p class="mt-0.5 text-[12.5px] text-faint [overflow-wrap:anywhere]">
						for i, p := range u.projects {
							if i > 0 {
								{ " · " }
							}
							{ p.repository }
							if p.private {
								{ " (private)" }
							}
							if p.updates > 0 {
								{ " · " }<b class="font-medium text-ink">{ plural(p.updates, "rule update", "rule updates") }</b>
							} else {
								{ " · up to date" }
							}
						}
					</p>
				</div>
			</div>
		}
	</section>
	@gitHubSummary(d.gitHub) {
		<p class="mt-1.5 text-[12px] text-faint">Read from each project's <span class="mono">.code-rules/generated/provenance.json</span>.</p>
	}
}

// gitHubSummary ends My libraries and Projects, which both show what Rulemart read of the visitor's GitHub account, in
// one line, a section's gap below the list: whether the read includes private projects, when it was, with Refresh, and
// the way to include or manage private projects. While Rulemart can't show a read, the line says why instead, as
// gitHubStatus does. Its children, such as a footnote, follow it.
templ gitHubSummary(g gitHubView) {
	if g.available {
		<div class="mt-[30px]">
			if g.signInAgain != "" || g.failed || g.reading {
				@gitHubStatus(g, "")
			} else {
				<div class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[12px] text-faint" data-github-status>
					if g.private {
						<span>Including private projects from the repos you selected</span>
					} else {
						<span>Public repos only</span>
					}
					if g.readAt != "" {
						<span>·</span>
						<span>read from GitHub { g.readAt }</span>
						<span>·</span>
						@refreshButton(g.refresh, "Refresh")
					}
					if g.private {
						<span>·</span>
						<a class={ linkButtonStyle } href={ templ.SafeURL(privateHref) }>Manage</a>
					} else if g.privateAvailable {
						<span>·</span>
						<a class={ linkButtonStyle } href={ templ.SafeURL(privateHref) }>Include private projects</a>
					}
					@truncatedRead(g)
				</div>
			}
			{ children... }
		</div>
	}
}

// starredContent is Starred rules: the rules the visitor's stars count toward, newest first, as rule rows, or the empty
// state, then any star that counts toward no rule, under No longer counted, each with Unstar.
templ starredContent(d dashboardView) {
	if len(d.starred) == 0 {
		<div class="rounded-card border border-dashed border-border-strong px-[22px] py-[22px] text-center text-[14px] text-muted">You haven't starred any rules yet. Star a rule from its page.</div>
	} else {
		<h2 class="sr-only">Your starred rules</h2>
		@ruleRows() {
			for _, r := range d.starred {
				@ruleRow(r)
			}
		}
	}
	if len(d.uncounted) > 0 {
		<section class="mt-9" aria-labelledby="uncounted">
			<h2 id="uncounted" class={ subHeadStyle }>No longer counted<span class="font-normal text-faint">{ " · " + strconv.Itoa(len(d.uncounted)) }</span></h2>
			<p class="mt-1.5 mb-2.5 text-[13px] text-muted">These stars count toward no rule Rulemart shows now. Rulemart keeps them, in case their library comes back; unstar them to let them go.</p>
			for _, u := range d.uncounted {
				<div class={ listRowStyle }>
					<div class="min-w-0">
						<p class="leading-[1.35] font-semibold [overflow-wrap:anywhere]">
							if u.href != "" {
								<a class="no-underline hover:underline" href={ templ.SafeURL(u.href) } rel="nofollow">{ u.title }</a>
							} else {
								{ u.title }
							}
						</p>
						<p class="mt-0.5 text-[12.5px] text-faint [overflow-wrap:anywhere]"><span class="mono">{ u.library } · { u.path }</span> · { u.why }</p>
					</div>
					<form method="post" action={ templ.SafeURL(u.unstar) }>
						<button class={ smallActionStyle } type="submit" aria-label={ "Unstar " + u.title }>Unstar</button>
					</form>
				</div>
			}
		</section>
	}
}
