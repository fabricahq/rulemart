// The browse pages: each kind's canonical groups that hold current rules in a vetted library, and the page of its
// groups that aren't canonical.

package web

import "strconv"

// browsePage lists a kind's canonical groups, one row each, by icon, name, and for a practice, description, with tabs
// between the kinds, and leads to the kind's other groups when any library declares one.
templ browsePage(c chrome, v browseView) {
	@layout(c, head{title: v.kind.name() + " · Rulemart", description: "Browse Code Rules by the " + v.kind.noun() + " they cover, across every vetted library.", section: v.kind.href(), noindex: v.unvetted, filters: true}) {
		<div class="page wrap">
			@label("") {
				Browse
			}
			<h1 class="title-xl mt-2">{ v.kind.name() }</h1>
			@tabs([]tab{
				{name: techsKind.name(), href: withUnvetted(techsKind.href(), v.unvetted), count: -1, on: v.kind == techsKind},
				{name: practicesKind.name(), href: withUnvetted(practicesKind.href(), v.unvetted), count: -1, on: v.kind == practicesKind},
			})
			<div class="-mt-2 mb-4">
				@unvettedOptIn(v.kind.href(), v.unvetted)
			</div>
			if len(v.groups) == 0 {
				<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">No { v.kind.noun() } groups yet.</div>
			} else {
				@rowList() {
					for _, g := range v.groups {
						@rowItem() {
							@rowLink(g.href, false, rowStacked) {
								// A practice's description keeps to one line on a wide screen, cut with an ellipsis if it must be. Below
								// that it wraps, and the tile stands at the top of the text rather than beside its middle.
								<div class={ "flex min-w-0 items-center gap-[14px]", templ.KV("max-wide:items-start", v.described(g)) }>
									@groupTile(g.label, g.icon, tileRow)
									<div class="min-w-0 flex-1">
										<div class="flex flex-wrap items-center gap-x-2 gap-y-1 leading-[1.35] font-semibold">
											{ g.label.name }
											if g.unvetted {
												@unvettedBadge()
											}
										</div>
										if v.described(g) {
											<div class="mt-0.5 text-[12.5px] text-faint wide:truncate">{ g.blurb }</div>
										}
									</div>
								</div>
								// On a phone, the counts line up under the text, past the tile and the gap beside it.
								<div class={ "flex flex-wrap items-center justify-end gap-x-[14px] gap-y-1.5 text-[13px] text-muted", stackedMeta("max-narrow:pl-[50px]") }>
									<span class="whitespace-nowrap">{ plural(g.rules, "rule", "rules") }</span>
									<span class="whitespace-nowrap">{ plural(len(g.libraries), "library", "libraries") }</span>
								</div>
							}
						}
					}
				}
			}
			if v.others > 0 {
				<p class="mt-6 text-[13px]"><a class="text-faint hover:text-ink" href={ templ.SafeURL(v.othersHref()) }>View other { v.kind.noun() } groups ({ strconv.Itoa(v.others) }) →</a></p>
			}
		</div>
	}
}

// otherGroupsPage lists a kind's groups that aren't canonical, one row per group ID with the libraries that chose
// it, each leading to the group's page, and says why they stand apart.
templ otherGroupsPage(c chrome, v otherGroupsView) {
	@layout(c, head{title: "Other " + v.kind.noun() + " groups · Rulemart", description: "The " + v.kind.noun() + " groups vetted libraries declare that aren't on Code Rules' canonical list, each holding the rules of the libraries that chose its ID.", section: v.kind.href(), noindex: v.unvetted, filters: true}) {
		<div class="page wrap">
			<div class="mb-[14px] flex flex-wrap items-center gap-1.5 text-[13px] text-faint">
				<a class="text-muted no-underline hover:text-ink hover:underline" href={ templ.SafeURL(withUnvetted(v.kind.href(), v.unvetted)) }>{ v.kind.name() }</a>
				<span>›</span>
				<span>Other groups</span>
			</div>
			<h1 class="title-xl">Other { v.kind.noun() } groups</h1>
			<div class="mt-2.5 mb-[22px] max-w-[46rem] text-muted">
				<p class="mb-2.5">Rulemart defines canonical “rule groups” like <code>{ v.kind.exampleGroup() }</code> so that all rules from many user libraries can be aggregated in one place.</p>
				<p>All other groups that are not canonical are shown here. Each one's page holds the rules of the libraries that chose its exact name, and its rules are searchable, but they aren't combined with rules from other groups.</p>
			</div>
			<div class="mb-4">
				@unvettedOptIn(v.kind.othersHref(), v.unvetted)
			</div>
			if len(v.groups) == 0 {
				<div class="rounded-card border border-dashed border-border-strong p-[22px] text-center text-[14px] text-muted">None right now.</div>
			} else {
				@rowList() {
					for _, g := range v.groups {
						@rowItem() {
							@rowLink(g.href, false, rowBeside) {
								<div class="min-w-0">
									<div class="flex flex-wrap items-center gap-x-2 gap-y-1 leading-[1.35] font-medium">
										<span class="mono">
											@breakable(g.label.id)
										</span>
										if g.unvetted {
											@unvettedBadge()
										}
									</div>
									<div class="mt-0.5 text-[12.5px] text-faint [overflow-wrap:anywhere]">{ libraryNames(g) }</div>
								</div>
								<span class="text-[13px] whitespace-nowrap text-muted">{ plural(g.rules, "rule", "rules") }</span>
							}
						}
					}
				}
			}
		</div>
	}
}
