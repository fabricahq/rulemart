// Pieces several pages share: avatars, labels, chips, tabs, panels, lists, rule cards, and the search form.

package web

import (
	"strconv"
	"strings"

	"github.com/fabricahq/rulemart/internal/contexts/catalog/domain"
)

// avatarSize is an avatar's box: its size, corner radius, and initial's size.
type avatarSize string

const (
	avatarXS avatarSize = "size-[18px] rounded-[4px] text-[8px]"
	avatarSM avatarSize = "size-[30px] rounded-[8px] text-[11px]"
	avatarMD avatarSize = "size-10 rounded-[10px] text-[13px]"
	avatarLG avatarSize = "size-14 rounded-[14px] text-[20px]"
)

// avatar shows an owner's GitHub avatar, or the owner's initial when there's none.
templ avatar(src, owner string, size avatarSize) {
	<span class={ "relative inline-grid flex-none place-items-center overflow-hidden border border-border font-semibold text-ink", string(size), templ.KV("bg-white", src != ""), templ.KV("bg-surface-header", src == "") }>
		if src != "" {
			<img class="absolute inset-0 size-full object-cover" src={ src } alt=""/>
		} else {
			{ strings.ToUpper(owner[:1]) }
		}
	</span>
}

// tileSize is a group tile's box: its size, corner radius, and initial's size.
type tileSize string

const (
	tileXS tileSize = "size-[18px] rounded-[4px] text-[9px]"
	tileMD tileSize = "size-7 rounded-[7px] text-[12px]"
	tileLG tileSize = "size-14 rounded-[14px] text-[22px]"
)

// groupTile marks a group in a list: a canonical group with its icon, or with its name's initial when Rulemart has
// no icon for it, and any other group with an empty dashed tile, so names line up either way. Monochrome icons are
// inverted in dark themes, and narrow icons fill more of the tile so they look as big as square logos.
templ groupTile(label groupLabel, icon groupIcon, size tileSize) {
	if icon.src != "" {
		<span class={ "inline-grid flex-none place-items-center border border-border-subtle bg-icon-tile", string(size) }>
			<img class={ "object-contain", templ.KV("size-[64%]", !icon.narrow), templ.KV("size-[88%]", icon.narrow), templ.KV("icon-ink", icon.monochrome) } src={ icon.src } alt=""/>
		</span>
	} else if label.canonical {
		<span class={ "inline-grid flex-none place-items-center border border-border-subtle bg-icon-tile leading-none font-semibold tracking-normal text-muted normal-case", string(size) } aria-hidden="true">{ label.initial() }</span>
	} else {
		<span class={ "inline-block flex-none border border-dashed border-border", string(size) } aria-hidden="true"></span>
	}
}

// flagSize is a "not canonical" flag's type size and line height, which with its border sets its height.
type flagSize string

const (
	// flagSM fits a line of small metadata, such as a section header or a breadcrumb: 15px tall, in type no larger
	// than the group ID beside it.
	flagSM flagSize = "text-[9px] leading-[13px]"
	// flagMD sits on its own line under a group's ID.
	flagMD flagSize = "text-[10.5px] leading-[15px]"
)

// notCanonical flags a group that isn't on Code Rules' canonical group list, explained on hover.
templ notCanonical(size flagSize) {
	<span class={ "inline-block flex-none rounded-[4px] border border-dashed border-border-strong px-1.5 align-middle font-mono font-normal tracking-normal whitespace-nowrap text-faint normal-case", string(size) } title={ notCanonicalExplanation }>not canonical</span>
}

// label is a small uppercase heading, such as a list's or a panel's.
templ label(class string) {
	<p class={ "text-[12px] font-medium tracking-[.12em] text-muted uppercase", class }>
		{ children... }
	</p>
}

// impact shows a rule's declared impact, explained on hover.
templ impact(level string) {
	<span class={ "rounded-[4px] border px-[5px] font-mono text-[10px] font-normal tracking-[.04em] whitespace-nowrap", templ.KV("border-border-strong text-muted", level == "CRITICAL"), templ.KV("border-border text-faint", level != "CRITICAL") } title={ impactExplanation(level) }>{ level }</span>
}

// chip is a quiet, rounded label.
templ chip() {
	<span class="inline-flex items-center gap-1.5 rounded-full border border-border px-[11px] py-0.5 text-[12.5px] whitespace-nowrap text-muted">
		{ children... }
	</span>
}

// smallButton is a link styled as a small outlined button.
templ smallButton(href string) {
	<a class="inline-flex min-h-8 items-center justify-center gap-2 rounded-full border border-border-strong px-[13px] py-1 text-[13px] font-medium whitespace-nowrap text-ink no-underline transition-colors duration-[160ms] hover:border-ink hover:bg-surface" href={ templ.SafeURL(href) }>
		{ children... }
	</a>
}

// tab is one tab in a page's tab bar; count is shown after its name when it's 0 or more.
type tab struct {
	name, href string
	count      int
	on         bool
}

templ tabs(items []tab) {
	<nav class="mt-[26px] mb-[22px] flex gap-6 overflow-x-auto border-b border-border [scrollbar-width:none]">
		for _, t := range items {
			<a
				class={ "pb-[11px] text-[14px] whitespace-nowrap no-underline hover:text-ink", templ.KV("font-medium text-ink shadow-[inset_0_-2px_var(--ink)]", t.on), templ.KV("text-muted", !t.on) }
				href={ templ.SafeURL(t.href) }
				if t.on {
					aria-current="page"
				}
			>
				{ t.name }@tabCount(t.count)
			</a>
		}
	</nav>
}

// tabCount shows a tab's count right after its name, or nothing for a negative count.
templ tabCount(count int) {
	if count >= 0 {
		<span class="ml-[5px] text-faint">{ strconv.Itoa(count) }</span>
	}
}

// rowList frames rows that are each one full-width target.
templ rowList() {
	<div class="overflow-hidden rounded-card border border-border bg-paper">
		{ children... }
	</div>
}

// ruleCardLink is a rule's card in a list of rules, leading to its page.
templ ruleCardLink(r ruleCard) {
	<a class="mb-2.5 block rounded-card border border-border px-4 py-[14px] text-ink no-underline transition-colors duration-[160ms] hover:border-border-strong hover:bg-surface" href={ templ.SafeURL(r.href) }>
		<div class="mb-1.5 flex flex-wrap items-center gap-2 text-[15.5px] leading-[1.35] font-semibold">
			<span>{ r.title }</span>
			@impact(r.impact)
		</div>
		<div class="flex flex-wrap items-center gap-x-[14px] gap-y-1.5 text-[13px] text-muted">
			<span class="mono" title="Latest version">{ r.version }</span>
			<span class="mono text-faint">{ r.id }</span>
		</div>
	</a>
}

// searchForm is a search field with its button, which searches the rules of every vetted library. query fills the
// field, and autofocus focuses it when the page loads. The field's focus thickens the form's own border into one ring,
// and the button keeps its own focus ring.
templ searchForm(id, query string, autofocus bool) {
	<form class="flex w-full items-center gap-2 rounded-full border border-border-strong bg-paper py-1 pr-1 pl-4 has-[input:focus-visible]:border-(--focus) has-[input:focus-visible]:shadow-[0_0_0_1px_var(--focus)]" action={ templ.SafeURL(searchHref) } method="get" role="search">
		@searchIcon("size-[18px] flex-none text-faint")
		<label class="sr-only" for={ id }>Search rules</label>
		<input id={ id } class="h-10 min-w-0 flex-1 bg-transparent text-[16px] text-ink placeholder:text-faint focus-visible:outline-none [&::-webkit-search-cancel-button]:hidden" type="search" name="q" value={ query } placeholder="Search rules" maxlength={ strconv.Itoa(domain.MaxSearchQueryLength) } autocomplete="off" autofocus?={ autofocus }/>
		<button class="min-h-10 flex-none cursor-pointer rounded-full bg-primary px-5 text-[14px] font-medium text-on-primary transition-opacity hover:opacity-85" type="submit">Search</button>
	</form>
}

// aboutPanel frames a library's or rule's facts beside its content, as label and value pairs, each fact a fact.
templ aboutPanel() {
	<section class="rounded-card border border-border" aria-labelledby="about">
		<h2 id="about" class="border-b border-border px-4 py-2.5 text-[12px] font-medium tracking-[.12em] text-muted uppercase">About</h2>
		<dl class="grid gap-2.5 px-4 py-3.5 text-[13px]">
			{ children... }
		</dl>
	</section>
}

// fact is one fact in an aboutPanel. A long value wraps at its parts.
templ fact(name string) {
	<div class="flex items-baseline justify-between gap-4">
		<dt class="shrink-0 text-muted">{ name }</dt>
		<dd class="min-w-0 text-right [overflow-wrap:anywhere]">
			{ children... }
		</dd>
	</div>
}

// factLink is a fact's value that links elsewhere, in code type, which wraps at its parts.
templ factLink(href, text, title string) {
	<a class="font-mono text-[.86em]" href={ templ.SafeURL(href) } title={ title }>
		@breakable(text)
	</a>
}

// libraryFacts is the facts every library page shows beside its content.
templ libraryFacts(lib libraryView) {
	@aboutPanel() {
		@fact("Owner") {
			<a href={ templ.SafeURL(lib.ownerURL) }>{ lib.owner }</a>
		}
		@fact("Repository") {
			@factLink(lib.githubURL, lib.name, "github.com/"+lib.owner+"/"+lib.name)
		}
		@fact("License") {
			@license(lib)
		}
		@fact("Latest library release") {
			@factLink(lib.latestURL, lib.latestTag, "GitHub Release page for "+lib.latestTag)
		}
		@fact("Updated") {
			{ lib.updated }
		}
	}
}

// license shows the declared SPDX expression, or else a link to the declared license file.
templ license(lib libraryView) {
	if lib.license != "" {
		{ lib.license }
	} else if lib.licenseFile != "" {
		@factLink(lib.licenseURL, lib.licenseFile, lib.licenseFile)
	} else {
		<span class="text-faint">Not declared</span>
	}
}
