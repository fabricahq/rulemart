// Pieces several pages share: avatars, labels, chips, tabs, panels, lists, library rows, rule cards and results, and
// the search form.

package web

import (
	"strconv"
	"strings"

	"github.com/fabricahq/rulemart/internal/contexts/catalog/domain"
)

// avatarSize is an avatar's box: its size, corner radius, and initial's size.
type avatarSize string

const (
	avatarXS avatarSize = "size-[18px] rounded-[4px] text-[8px]"
	avatarSM avatarSize = "size-[30px] rounded-[8px] text-[11px]"
	avatarMD avatarSize = "size-10 rounded-[10px] text-[13px]"
	avatarLG avatarSize = "size-14 rounded-[14px] text-[20px]"
	avatarXL avatarSize = "size-[72px] rounded-[18px] text-[26px]"
	// avatarRound is a person's avatar in the header, a circle as the prototype draws a user's.
	avatarRound avatarSize = "size-[30px] rounded-full text-[11px]"
)

// avatar shows an owner's GitHub avatar, or the owner's initial when there's none.
templ avatar(src, owner string, size avatarSize) {
	<span class={ "relative inline-grid flex-none place-items-center overflow-hidden border border-border font-semibold text-ink", string(size), templ.KV("bg-white", src != ""), templ.KV("bg-surface-header", src == "") }>
		if src != "" {
			<img class="absolute inset-0 size-full object-cover" src={ src } alt=""/>
		} else {
			{ strings.ToUpper(owner[:1]) }
		}
	</span>
}

// tileSize is a group tile's box: its size, corner radius, and initial's size.
type tileSize string

const (
	tileXS tileSize = "size-[18px] rounded-[4px] text-[9px]"
	tileMD tileSize = "size-7 rounded-[7px] text-[12px]"
	// tileRow is a browse page's row icon, the prototype's medium tile.
	tileRow tileSize = "size-9 rounded-[9px] text-[14px]"
	tileLG tileSize = "size-14 rounded-[14px] text-[22px]"
	// tileTitle stands beside a group page's title, the prototype's large tile.
	tileTitle tileSize = "size-12 rounded-[12px] text-[20px]"
)

// groupTile marks a group in a list: a canonical group with its icon, or with its name's initial when Rulemart has
// no icon for it, and any other group with an empty dashed tile, so names line up either way. Monochrome icons are
// inverted in dark themes, colored icons drawn mostly in dark colors keep a light tile in dark themes, and narrow icons
// fill more of the tile so they look as big as square logos.
templ groupTile(label groupLabel, icon groupIcon, size tileSize) {
	if icon.src != "" {
		<span class={ "inline-grid flex-none place-items-center border border-border-subtle", string(size), templ.KV("bg-icon-tile", !icon.lightTile), templ.KV("bg-white", icon.lightTile) }>
			<img class={ "object-contain", templ.KV("size-[64%]", !icon.narrow), templ.KV("size-[88%]", icon.narrow), templ.KV("icon-ink", icon.monochrome) } src={ icon.src } alt=""/>
		</span>
	} else if label.canonical {
		<span class={ "inline-grid flex-none place-items-center border border-border-subtle bg-icon-tile leading-none font-semibold tracking-normal text-muted normal-case", string(size) } aria-hidden="true">{ label.initial() }</span>
	} else {
		<span class={ "inline-block flex-none border border-dashed border-border", string(size) } aria-hidden="true"></span>
	}
}

// flagSize is a "not canonical" flag's type size and line height, which with its border sets its height.
type flagSize string

const (
	// flagSM fits a line of small metadata, such as a section header or a breadcrumb: 15px tall, in type no larger
	// than the group ID beside it.
	flagSM flagSize = "text-[9px] leading-[13px]"
	// flagMD sits on its own line under a group's ID.
	flagMD flagSize = "text-[10.5px] leading-[15px]"
)

// notCanonical flags a group that isn't on Code Rules' canonical group list, explained on hover.
templ notCanonical(size flagSize) {
	<span class={ "inline-block flex-none rounded-[4px] border border-dashed border-border-strong px-1.5 align-middle font-mono font-normal tracking-normal whitespace-nowrap text-faint normal-case", string(size) } title={ notCanonicalExplanation }>not canonical</span>
}

// label is small uppercase text that names what follows, such as a page's eyebrow.
templ label(class string) {
	<p class={ labelStyle, class }>
		{ children... }
	</p>
}

// labelHeading is a section's heading in a label's style, at level 2.
templ labelHeading(class string) {
	<h2 class={ labelStyle, class }>
		{ children... }
	</h2>
}

// impact shows a rule's declared impact, explained on hover.
templ impact(level string) {
	<span class={ "rounded-[4px] border px-[5px] font-mono text-[10px] font-normal tracking-[.04em] whitespace-nowrap", templ.KV("border-border-strong text-muted", level == "CRITICAL"), templ.KV("border-border text-faint", level != "CRITICAL") } title={ impactExplanation(level) }>{ level }</span>
}

// chipLink is a quiet, rounded label that leads somewhere, such as a popular group on the home page.
templ chipLink(href string) {
	<a class="inline-flex items-center gap-1.5 rounded-full border border-border px-[11px] py-0.5 text-[12.5px] whitespace-nowrap text-muted no-underline hover:border-border-strong hover:text-ink" href={ templ.SafeURL(href) }>
		{ children... }
	</a>
}

// bigSearch is the home page's search field, the prototype's: one wide field with a magnifying glass, submitted with
// Enter, which searches the rules of every vetted library.
templ bigSearch(id string) {
	<form class="relative mx-auto mt-8 max-w-[560px] text-left" action={ templ.SafeURL(searchHref) } method="get" role="search">
		<label class="sr-only" for={ id }>Search rules</label>
		@searchIcon("pointer-events-none absolute top-1/2 left-[18px] size-[17px] -translate-y-1/2 text-faint")
		<input id={ id } class="w-full rounded-full border border-border-strong bg-paper py-[14px] pr-5 pl-[46px] text-[16px] text-ink placeholder:text-faint focus-visible:border-(--focus) focus-visible:shadow-[0_0_0_1px_var(--focus)] focus-visible:outline-none" type="search" name="q" placeholder="Try React effects, logging, testing" maxlength={ strconv.Itoa(domain.MaxSearchQueryLength) } autocomplete="off"/>
	</form>
}

// smallButton is a link styled as a small outlined button.
templ smallButton(href string) {
	<a class="inline-flex min-h-8 items-center justify-center gap-2 rounded-full border border-border-strong px-[13px] py-1 text-[13px] font-medium whitespace-nowrap text-ink no-underline transition-colors duration-[160ms] hover:border-ink hover:bg-surface" href={ templ.SafeURL(href) }>
		{ children... }
	</a>
}

// tab is one tab in a page's tab bar; count is shown after its name when it's 0 or more.
type tab struct {
	name, href string
	count      int
	on         bool
}

// tabs is a page's tab bar. Its tabs fit a narrow phone's width at a smaller size, and wrap onto a second row rather
// than scroll, so no tab, or its focus ring, is ever hidden.
templ tabs(items []tab) {
	<nav class="mt-[26px] mb-[22px] flex flex-wrap gap-x-6 border-b border-border max-tiny:gap-x-4">
		for _, t := range items {
			<a
				class={ "pb-[11px] text-[14px] whitespace-nowrap no-underline hover:text-ink max-tiny:text-[13px]", templ.KV("font-medium text-ink shadow-[inset_0_-2px_var(--ink)]", t.on), templ.KV("text-muted", !t.on) }
				href={ templ.SafeURL(t.href) }
				if t.on {
					aria-current="page"
				}
			>
				{ t.name }@tabCount(t.count)
			</a>
		}
	</nav>
}

// tabCount shows a tab's count right after its name, or nothing for a negative count. Screen readers hear a comma
// between them, rather than the name and count run together.
templ tabCount(count int) {
	if count >= 0 {
		<span class="sr-only">, </span><span class="ml-[5px] text-faint">{ strconv.Itoa(count) }</span>
	}
}

// rowList frames rows that are each one full-width target, as a list whose items rowItem makes, divided by lines.
templ rowList() {
	<ul class="divide-y divide-border-subtle overflow-hidden rounded-card border border-border bg-paper">
		{ children... }
	</ul>
}

// rowLayout is where a rowLink's column of metadata sits on a phone.
type rowLayout string

const (
	// rowBeside keeps the metadata beside the content at every width, for metadata as short as one count.
	rowBeside rowLayout = ""
	// rowStacked drops the metadata under the content on a phone, where beside it, metadata as wide as two counts
	// would squeeze the content into a narrow column. The metadata places itself there, with stackedMeta.
	rowStacked rowLayout = "max-narrow:grid-cols-[minmax(0,1fr)_14px] max-narrow:gap-y-1"
)

// stackedMeta places a rowStacked row's metadata under its content on a phone, indented by indent, a padding class,
// to line up with the content's text.
func stackedMeta(indent string) string {
	return "max-narrow:col-start-1 max-narrow:row-start-2 max-narrow:justify-start " + indent
}

// rowLink is a row of a rowList that is one full-width link, laid out as the prototype's rowlink: its content, a
// column of metadata on the right, or under the content on a phone when layout says so, and a chevron that shows on
// hover. nofollow marks a link to an unvetted library's page. Its text wraps between words, breaking a word only
// when the word is wider than the whole line.
templ rowLink(href string, nofollow bool, layout rowLayout) {
	<a
		class={ "group grid grid-cols-[minmax(0,1fr)_auto_14px] items-center gap-[18px] px-[18px] py-[14px] text-ink no-underline [overflow-wrap:break-word] transition-colors duration-[120ms] hover:bg-surface focus-visible:outline-offset-[-3px]", string(layout) }
		href={ templ.SafeURL(href) }
		if nofollow {
			rel="nofollow"
		}
	>
		{ children... }
		@chevron()
	</a>
}

// chevron ends a rowLink: hidden until the row is hovered or focused, when it slides in.
templ chevron() {
	<span class="-translate-x-1 text-[20px] leading-none text-faint opacity-0 transition-[opacity,transform] duration-[120ms] group-hover:translate-x-0 group-hover:text-ink group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:text-ink group-focus-visible:opacity-100" aria-hidden="true">›</span>
}

// rowItem is one row of a rowList.
templ rowItem() {
	<li>
		{ children... }
	</li>
}

// libraryRow is a library's row in a list of libraries, the prototype's libLine: its owner's avatar, with the check
// mark when Rulemart vets the library, its name, the Unvetted chip on an unvetted library in a list of vetted ones,
// its description, and its repository with its rule count, leading to its page. The library's name is a heading of
// level 2, or 3 when headed is true, under a heading of the page's own. A link to an unvetted library's page carries
// nofollow.
templ libraryRow(lib libraryCard, headed bool) {
	@rowLink(lib.href, !lib.vetted, rowBeside) {
		<div class="flex min-w-0 items-start gap-[14px]">
			@libraryAvatar(lib.avatar, lib.owner, avatarMD, lib.vetted)
			<div class="min-w-0">
				<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
					if headed {
						<h3 class="leading-[1.35] font-semibold">{ lib.name }</h3>
					} else {
						<h2 class="leading-[1.35] font-semibold">{ lib.name }</h2>
					}
					if lib.vetted {
						<span class="sr-only">{ vettedTitle }</span>
					}
					if lib.tagged {
						@unvettedBadge()
					}
				</div>
				if lib.description != "" {
					<p class="mt-0.5 text-[13px] text-muted">{ lib.description }</p>
				}
				<div class="mt-1 text-[12.5px] text-faint">
					<span class="mono">
						@breakable(lib.owner + "/" + lib.name)
					</span>
					· { plural(lib.rules, "rule", "rules") }
				</div>
			</div>
		</div>
		// Fills rowLink's middle column, its metadata, where slice R7 will put the library's star total.
		<span></span>
	}
}

// vettedTitle is what the check mark on a vetted library says.
const vettedTitle = "Vetted by Rulemart"

// checkSize is the check mark's box for an avatar's size: its size, offset, and border.
func checkSize(size avatarSize) string {
	switch size {
	case avatarXS:
		return "-right-[3px] -bottom-[3px] size-2.5 border-[1.5px] [&>svg]:size-[7px]"
	case avatarLG, avatarXL:
		return "-right-1 -bottom-1 size-5 border-2 [&>svg]:size-3"
	}
	return "-right-[3px] -bottom-[3px] size-4 border-2 [&>svg]:size-2.5"
}

// libraryAvatar is a library's owner's avatar, carrying the prototype's check mark when vetted is true, which says
// "Vetted by Rulemart" on hover. Screen readers hear it where the library's name says it, as libraryRow's does.
templ libraryAvatar(src, owner string, size avatarSize, vetted bool) {
	if vetted {
		<span class="relative inline-flex flex-none" title={ vettedTitle }>
			@avatar(src, owner, size)
			<span class={ "absolute grid place-items-center rounded-full border-paper bg-vetted", checkSize(size) } data-vetted>
				<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3.2 6.2 5.1 8l3.7-4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</span>
		</span>
	} else {
		@avatar(src, owner, size)
	}
}

// ruleRows lists rule rows, each a ruleRow.
templ ruleRows() {
	<ul class="grid gap-2.5">
		{ children... }
	</ul>
}

// ruleRow is a rule in any list of rules on the site, the prototype's ruleResult, leading to the rule's page: its title
// and impact, with the Retired and Unvetted chips when they apply, the rule that replaced a retired one, the words of
// a search it lacks, the retired rule the visitor starred in its place, and then its library's mark and name, its
// group in a list that names it, and its stars. A retired rule is drawn grayed out, the same in every list, which
// data-retired marks. Its title is a heading of level 3, under a heading of the list's own.
templ ruleRow(r ruleRowView) {
	<li>
		<a
			class={ "block rounded-card border px-4 py-[14px] no-underline transition-colors duration-[160ms] hover:border-border-strong hover:bg-surface", templ.KV("border-border text-ink", !r.retired), templ.KV("border-border-subtle text-muted", r.retired) }
			href={ templ.SafeURL(r.href) }
			if r.unvetted {
				rel="nofollow"
			}
			if r.retired {
				data-retired
			}
		>
			<div class="text-[15.5px] leading-[1.35] font-semibold">
				<h3 class={ "mr-2 inline font-semibold", templ.KV("text-muted", r.retired) }>{ r.title }</h3>
				<span class="inline-flex flex-wrap items-center gap-1.5 align-[1px]">
					@impact(r.impact)
					if r.retired {
						@retiredBadge()
					}
					if r.unvetted {
						@unvettedBadge()
					}
				</span>
			</div>
			if r.retired && r.renamed {
				<p class="mt-1 text-[12.5px] text-faint">
					Renamed to{ " " }<span class="mono text-muted">
						@breakable(r.replacedBy)
					</span>
				</p>
			} else if r.retired && r.replacedBy != "" {
				<p class="mt-1 text-[12.5px] text-faint">Replaced by <span class="text-muted">{ r.replacedBy }</span></p>
			}
			if len(r.missing) > 0 {
				<p class="mt-1 text-[12.5px] text-muted">
					Missing:
					for _, word := range r.missing {
						{ " " }<s>{ word }</s>
					}
				</p>
			}
			if r.starredAs != "" {
				<p class="mt-1 text-[12.5px] text-muted">
					You starred{ " " }<span class="mono">
						@breakable(r.starredAs)
					</span>, which this rule replaced.
				</p>
			}
			<div class={ "mt-1.5 flex flex-wrap items-center gap-x-[14px] gap-y-1.5 text-[13px]", templ.KV("text-muted", !r.retired), templ.KV("text-faint", r.retired) }>
				<span class={ "flex min-w-0 items-center gap-[7px]", templ.KV("[&>:first-child]:opacity-60", r.retired) }>
					@libraryMark(r.library, r.fabrica)
					<span class="min-w-0 [overflow-wrap:anywhere]">
						{ r.library.fullName() }
						if r.group != nil {
							{ " · " }{ r.group.display() }
						}
					</span>
				</span>
				@starCount(r.stars, true, "")
			</div>
		</a>
	</li>
}

// libraryMark is a library's small mark in a quiet row, the prototype's libMark: Fabrica's logo on a dark tile for a
// library of Fabrica's, and otherwise its owner's avatar.
templ libraryMark(lib libraryRefView, fabrica bool) {
	if fabrica {
		<span class="inline-grid size-[18px] flex-none place-items-center rounded-[4px] bg-primary text-on-primary" title="Published by Fabrica">
			@fabricaMark("size-3")
		</span>
	} else {
		@avatar(lib.avatar, lib.owner, avatarXS)
	}
}

// unvettedBadge marks a library Rulemart doesn't vet, or one of its rules, in the one amber the palette has.
templ unvettedBadge() {
	<span class="inline-flex items-center rounded-full border border-warn-border bg-warn-surface px-2 text-[11.5px] leading-[18px] font-medium text-warn-ink">Unvetted</span>
}

// retiredBadge marks a retired rule in a list.
templ retiredBadge() {
	<span class="inline-flex items-center rounded-full border border-border px-2 text-[11.5px] leading-[18px] font-medium text-muted">Retired</span>
}

// pageFocus is the attributes of a control the page focuses after the visitor's click, such as the star button after
// starring, or none when focused is false: autofocus, which focuses it without a script, and data-autofocused, which
// draws a quiet ring in place of the keyboard's, since the visitor clicked, until menus.js takes it off at their first
// key or when focus leaves the control. Without JavaScript the ring stays quiet on that page.
func pageFocus(focused bool) templ.Attributes {
	if !focused {
		return nil
	}
	return templ.Attributes{"autofocus": true, "data-autofocused": true}
}

// searchForm is a search field with its button, which searches the rules of every vetted library. query fills the
// field, and autofocus focuses it when the page loads. The field's focus thickens the form's own border into one ring,
// and the button keeps its own focus ring.
templ searchForm(id, query string, autofocus bool) {
	<form class="flex w-full items-center gap-2 rounded-full border border-border-strong bg-paper py-1 pr-1 pl-4 has-[input:focus-visible]:border-(--focus) has-[input:focus-visible]:shadow-[0_0_0_1px_var(--focus)]" action={ templ.SafeURL(searchHref) } method="get" role="search">
		@searchIcon("size-[18px] flex-none text-faint")
		<label class="sr-only" for={ id }>Search rules</label>
		<input id={ id } class="h-10 min-w-0 flex-1 bg-transparent text-[16px] text-ink placeholder:text-faint focus-visible:outline-none" type="search" name="q" value={ query } placeholder="Search rules" maxlength={ strconv.Itoa(domain.MaxSearchQueryLength) } autocomplete="off" autofocus?={ autofocus }/>
		<button class="min-h-10 flex-none cursor-pointer rounded-full bg-primary px-5 text-[14px] font-medium text-on-primary transition-opacity hover:opacity-85" type="submit">Search</button>
	</form>
}

// aboutPanel frames a library's or rule's facts beside its content, as label and value pairs, each fact a fact, and
// a note under them when note isn't nil.
templ aboutPanel(note templ.Component) {
	<section class="rounded-card border border-border" aria-labelledby="about">
		<h2 id="about" class="border-b border-border px-4 py-2.5 text-[12px] font-medium tracking-[.12em] text-muted uppercase">About</h2>
		<dl class="grid gap-2.5 px-4 py-3.5 text-[13px]">
			{ children... }
		</dl>
		if note != nil {
			<div class="border-t border-border px-4 py-3 text-[12.5px] text-muted">
				@note
			</div>
		}
	</section>
}

// impactNote says what a rule's impact level means, where a touch or a keyboard reaches it, as the impact label's
// hover text does, and links Code Rules' explanation of the levels.
templ impactNote(level string) {
	<p id="impact-meaning">
		{ impactExplanation(level) } <a class="whitespace-nowrap" href={ templ.SafeURL(impactLevelsDocs) }>Impact levels</a>
	</p>
}

// fact is one fact in an aboutPanel. A long value wraps at its parts.
templ fact(name string) {
	<div class="flex items-start justify-between gap-4">
		<dt class="shrink-0 text-muted">{ name }</dt>
		<dd class="min-w-0 text-right [overflow-wrap:anywhere]">
			{ children... }
		</dd>
	</div>
}

// factLink is a fact's value that links elsewhere, in code type, which wraps at its parts.
templ factLink(href, text, title string) {
	<a class="font-mono text-[.86em]" href={ templ.SafeURL(href) } title={ title }>
		@breakable(text)
	</a>
}

// libraryFacts is the facts every library page shows beside its content, and where to report the library.
templ libraryFacts(lib libraryView) {
	@aboutPanel(reportLibrary(lib)) {
		@fact("Owner") {
			<a href={ templ.SafeURL(lib.ownerHref) }>{ lib.owner }</a>
		}
		@fact("Repository") {
			@factLink(lib.githubURL, lib.name, "github.com/"+lib.owner+"/"+lib.name)
		}
		@fact("License") {
			@license(lib)
		}
		@fact("Latest library release") {
			@factLink(lib.latestHref, lib.latestTag, "What "+lib.latestTag+" published")
		}
		@fact("Updated") {
			{ lib.updated }
		}
	}
}

// reportLibrary leads to a report about lib on GitHub, with the library filled in.
templ reportLibrary(lib libraryView) {
	<p>Rules harmful, misleading, or not what they claim? <a class="whitespace-nowrap" href={ templ.SafeURL(reportLibraryURL(lib.fullName())) }>Report this library</a></p>
}

// license shows the declared SPDX expression, or else a link to the declared license file.
templ license(lib libraryView) {
	if lib.license != "" {
		{ lib.license }
	} else if lib.licenseFile != "" {
		@factLink(lib.licenseURL, lib.licenseFile, lib.licenseFile)
	} else {
		<span class="text-faint">Not declared</span>
	}
}
